# Caddy configuration for production
# File: /etc/caddy/Caddyfile
#
# ⚠️ Копия живого конфига. До 09.08.2026 она разошлась с реальностью: здесь фронт
# ещё значился «future» и `bibliaris.com` редиректил на `/docs`, тогда как на
# сервере он уже год проксировался на Next.js. Сверять при каждой правке —
# источник правды на сервере, а не здесь.
#
# Сверено с живым `/etc/caddy/Caddyfile` 03.10.2026: совпадает. `X-Robots-Tag noindex`
# на api (кроме `/static/*`) включён на сервере 03.10.2026 (LEGACY-054, слово владельца).
# Правил 403 на `/api/metrics`, rate limiting и `encode` на api на сервере нет.

# ============================================
# API Backend
# ============================================
api.bibliaris.com {
	# The API subdomain must never be indexed. Deliberately NOT "Disallow: /"
	# in robots.txt — the frontend fetches this host from the browser and
	# blocking crawling would stop Googlebot from rendering the site.
	# NestJS sets this (robots-header.middleware.ts); this is the second layer
	# for responses that bypass the app (502, Caddy errors). `/static/*` is
	# excluded exactly like in the middleware (its mismatch with ServeStatic's
	# serveRoot '/' is the LEGACY-054 remainder; prod covers live on R2).
	# Set immediately (not deferred with `>`): a deferred header never reaches
	# Caddy's own 502 when the upstream is down. The app's copy is dropped by
	# `header_down`, so a proxied response carries the header once.
	@apinoindex not path /static/*
	header @apinoindex X-Robots-Tag noindex

	# Proxy to internal application port
	handle {
		reverse_proxy localhost:5000 {
			header_down -X-Robots-Tag
		}
	}

	# Basic security headers
	header {
		# Remove server information
		-Server

		# Security headers
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		X-XSS-Protection "1; mode=block"
		Referrer-Policy strict-origin-when-cross-origin

		# HSTS (enforce HTTPS)
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

		# CORS headers (NestJS also sets these, but provides an additional layer of protection)
		Access-Control-Allow-Credentials "true"
	}
}

# ============================================
# Frontend (Next.js SSR)
# ============================================
bibliaris.com {
	encode zstd gzip

	# 🔴 Апстрим вынесен в отдельный файл, потому что это переключатель выката, а
	# не константа. `scripts/deploy-bluegreen.sh` в `books-front` переписывает его
	# на порт той версии, которая уже подтвердила готовность, и делает
	# `caddy reload` — тот дослуживает открытые соединения на прошлом конфиге.
	#
	# Содержимое — одна строка: `reverse_proxy 127.0.0.1:3001` (blue) либо
	# `:3002` (green). Файл же и есть единственный источник правды о том, какая
	# версия наверху: скрипт читает текущий цвет из него, а не из отдельного
	# файла состояния, который рассинхронизировался бы при первой ручной правке.
	import /etc/caddy/frontend-upstream.caddy

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output file /var/log/caddy/bibliaris.log
		format json
	}
}

# ============================================
# WWW redirects (disabled until DNS records exist)
# Add A/CNAME records for www.bibliaris.com and www.api.bibliaris.com
# then uncomment the blocks below and reload Caddy.
# ============================================
# www.bibliaris.com {
#     redir https://bibliaris.com{uri} permanent
# }
#
# www.api.bibliaris.com {
#     redir https://api.bibliaris.com{uri} permanent
# }
