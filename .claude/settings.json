{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ast-index update",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": ["../books-front", "../books-app-docs"],
    "allow": ["Bash", "Read", "Edit", "Write", "Glob", "Grep"],
    "ask": ["Bash(git commit:*)", "Bash(git push:*)"],
    "deny": [
      "Bash(yarn prisma:migrate:*)",
      "Bash(yarn prisma:seed:*)",
      "Bash(yarn prisma:studio:*)",
      "Bash(yarn db:*)",
      "Bash(yarn cleanup:*)",
      "Bash(npx prisma:*)",
      "Bash(prisma:*)",
      "Bash(psql:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose -f docker-compose.prod.yml:*)",
      "Bash(docker compose -f docker-compose.monitoring.yml:*)",
      "Bash(docker compose --profile prod:*)",
      "Bash(docker exec:*)",
      "Bash(docker run:*)",
      "Bash(docker container:*)",
      "Bash(docker create:*)",
      "Bash(docker start:*)",
      "Bash(docker cp:*)",
      "Bash(docker-compose:*)",
      "Bash(docker compose --file:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(//d/newDev/.env.prod.server)"
    ]
  }
}
