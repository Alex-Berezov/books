{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ast-index update",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": ["../books-front", "../books-app-docs"],
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "ask": [],
    "deny": [
      "Bash(docker-compose:*)",
      "Bash(docker start:*)",
      "Bash(docker create:*)",
      "Bash(docker container:*)",
      "Bash(docker cp:*)",
      "Bash(docker exec:*)",
      "Bash(docker run:*)",
      "Bash(yarn cleanup:*)",
      "Bash(docker compose -f docker-compose.prod.yml:*)",
      "Bash(docker compose -f docker-compose.monitoring.yml:*)",
      "Bash(docker compose --profile prod:*)",
      "Bash(docker compose --file:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(//d/newDev/.env.prod.server)",
      "Bash(docker compose down:*)",
      "Bash(docker compose run:*)",
      "Bash(docker compose exec:*)"
    ]
  }
}
