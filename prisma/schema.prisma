  @@index([canonicalName])
  @@index([sortName])
  @@index([birthYear])
  @@index([deathYear])
  @@index([publicDomainFromYear])
  @@index([wikidataId])
  @@index([viafId])
  @@index([isni])
  @@index([gutenbergAgentId])
