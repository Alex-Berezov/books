datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// =====================
// Main entities
// =====================

model Book {
  id        String        @id @default(uuid())
  slug      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  versions  BookVersion[]
  ratings   BookRating[]
  geoBlockRules GeoBlockRule[]

  // Phase 6: Rights clearance links
  rightsIntakeId String? @unique
  rightsIntake RightsIntake? @relation("BookRightsIntake", fields: [rightsIntakeId], references: [id], onDelete: SetNull)

  currentRightsProfileId String?
  currentRightsProfile RightsProfile? @relation("BookCurrentRightsProfile", fields: [currentRightsProfileId], references: [id], onDelete: SetNull)

  approvedRightsReviewId String?
  approvedRightsReview RightsReview? @relation("BookApprovedRightsReview", fields: [approvedRightsReviewId], references: [id], onDelete: SetNull)

  rightsCreatedAt DateTime?

  // Phase 6: Back-relation to RightsIntake (createdBook)
  sourceRightsIntake RightsIntake? @relation("RightsIntakeCreatedBook")

  @@index([rightsIntakeId])
  @@index([currentRightsProfileId])
  @@index([approvedRightsReviewId])
}

model BookVersion {
  id              String            @id @default(uuid())
  bookId          String
  language        Language
  title           String
  author          String
  description     String
  coverImageUrl   String
  type            BookType
  isFree          Boolean
  referralUrl     String?
  slug            String?
  // Publication
  status          PublicationStatus @default(published)
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  book            Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  summaries       BookSummary[]
  chapters        Chapter[]
  audioChapters   AudioChapter[]
  bookshelf       Bookshelf[]
  comments        Comment[]
  likes           Like[]
  categories      BookCategory[]
  tags            BookTag[]
  viewStats       ViewStat[]
  readingProgress ReadingProgress[]
  seo             Seo?              @relation("SeoForBookVersion", fields: [seoId], references: [id])
  seoId           Int?              @unique
  previewMedia    MediaAsset?       @relation("VersionPreviewMedia", fields: [previewMediaId], references: [id], onDelete: SetNull)
  previewMediaId  String?
  primaryCategoryId String?
  primaryCategory   Category?       @relation("BookVersionPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  firstPublishedYear    Int?
  editionPublishedYear  Int?
  originalLanguage      String?
  copyrightStatus       String?
  authorPageUrl         String?
  authorId              String?
  authorRelation        Author?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  characters            Json?
  quotes                Json?
  faq                   Json?
  themes                Json?
  originalTitle         String?
  alternativeTitles     Json?
  shortDescription      String?
  summaryShort          String?
  symbols               Json?
  coverAlt              String?

  // Phase 6: Rights snapshot
  rightsProfileId String?
  rightsProfile RightsProfile? @relation("BookVersionRightsProfile", fields: [rightsProfileId], references: [id], onDelete: SetNull)

  approvedRightsReviewId String?
  approvedRightsReview RightsReview? @relation("BookVersionApprovedRightsReview", fields: [approvedRightsReviewId], references: [id], onDelete: SetNull)

  rightsStatus String?
  rightsAllowedCountryCodes Json?
  rightsBlockedCountryCodes Json?
  rightsLicenseRequiredCountryCodes Json?
  rightsPendingCountryCodes Json?
  rightsRequiredActions Json?

  // Phase 7: Publication gate geo-block fields
  rightsGeoBlockRequired Boolean @default(false)
  rightsGeoBlockConfigured Boolean @default(false)
  rightsGeoBlockConfiguredAt DateTime?
  rightsGeoBlockNotesRu String?
  rightsGeoBlockVerifiedAt DateTime?
  rightsGeoBlockVerifiedByUserId String?
  rightsGeoBlockVerifiedBy User? @relation("BookVersionGeoBlockVerifiedBy", fields: [rightsGeoBlockVerifiedByUserId], references: [id], onDelete: SetNull)
  rightsGeoBlockLastGeneratedAt DateTime?
  geoBlockRules GeoBlockRule[]

  // Phase 8: Content hash & stale detection
  rightsContentHash String?
  rightsContentHashAlgorithmVersion String?
  rightsContentHashInput Json?
  rightsContentHashCalculatedAt DateTime?
  rightsRecheckRequired Boolean @default(false)
  rightsStaleDetectedAt DateTime?
  rightsStaleReasonCode String?
  rightsStaleReasonRu String? @db.Text
  rightsContentHashEvents RightsContentHashEvent[]

  contributors BookVersionContributor[]

  @@unique([bookId, language])
  @@unique([language, slug])
  @@index([bookId, language, type, isFree], name: "book_language_type_isFree_idx")
  @@index([previewMediaId])
  @@index([primaryCategoryId])
  @@index([authorId])
  @@index([rightsProfileId])
  @@index([approvedRightsReviewId])
  @@index([rightsContentHash])
  @@index([rightsRecheckRequired])
  @@index([rightsStaleDetectedAt])
  @@index([rightsGeoBlockVerifiedByUserId])
}

model BookSummary {
  id            String      @id @default(uuid())
  bookVersionId String
  summary       String
  analysis      String?
  themes        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  bookVersion   BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
}

model Chapter {
  id            String      @id @default(uuid())
  bookVersionId String
  number        Int
  title         String
  content       String
  createdAt     DateTime    @default(now())
  bookVersion   BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
  comments      Comment[]

  @@unique([bookVersionId, number])
}

model AudioChapter {
  id            String      @id @default(uuid())
  bookVersionId String
  number        Int
  title         String
  audioUrl      String
  duration      Int
  description   String?
  transcript    String?
  mediaId       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  bookVersion   BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
  media         MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  comments      Comment[]

  @@unique([bookVersionId, number])
  @@index([mediaId])
}

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  passwordHash       String?
  name               String?
  firstName          String?
  lastName           String?
  nickname           String?           @unique
  isActive           Boolean           @default(true)
  avatarUrl          String?
  languagePreference Language
  createdAt          DateTime          @default(now())
  lastLogin          DateTime?
  bookshelves        Bookshelf[]
  comments           Comment[]
  likes              Like[]
  viewStats          ViewStat[]
  readingProgress    ReadingProgress[]
  roles              UserRole[]
  ratings            BookRating[]
  mediaAssets        MediaAsset[]
  rightsIntakes      RightsIntake[]
  rightsReviewImports RightsReviewImport[]
  approvedRightsReviews RightsReview[] @relation("RightsReviewApprovedBy")
  rejectedRightsReviews RightsReview[] @relation("RightsReviewRejectedBy")
  rightsReviewApprovals RightsReviewApproval[]
  rightsContentHashEvents RightsContentHashEvent[]
  verifiedGeoBlockRules GeoBlockRule[] @relation("GeoBlockRuleVerifiedBy")
  verifiedGeoBlockVersions BookVersion[] @relation("BookVersionGeoBlockVerifiedBy")
}



model Bookshelf {
  id            String      @id @default(uuid())
  userId        String
  bookVersionId String
  addedAt       DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id])
  bookVersion   BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)

  @@unique([userId, bookVersionId])
}

model Comment {
  id             String        @id @default(uuid())
  userId         String
  bookVersionId  String?
  chapterId      String?
  audioChapterId String?
  parentId       String?
  ratingId       String?       @unique
  text           String
  isDeleted      Boolean       @default(false)
  isHidden       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id])
  bookVersion    BookVersion?  @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
  chapter        Chapter?      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  audioChapter   AudioChapter? @relation(fields: [audioChapterId], references: [id], onDelete: Cascade)
  rating         BookRating?   @relation(fields: [ratingId], references: [id], onDelete: SetNull)
  parent         Comment?      @relation("CommentParent", fields: [parentId], references: [id])
  children       Comment[]     @relation("CommentParent")
  likes          Like[]

  @@index([bookVersionId])
  @@index([chapterId])
  @@index([audioChapterId])
  @@index([parentId])
}

model Like {
  id            String       @id @default(uuid())
  userId        String
  bookVersionId String? // FK to BookVersion
  commentId     String? // FK to Comment
  isLike        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id])
  bookVersion   BookVersion? @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
  comment       Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@unique([userId, bookVersionId])
  @@index([commentId])
  @@index([bookVersionId])
}

model Category {
  id          String         @id @default(uuid())
  type        CategoryType
  name        String
  slug        String
  key         String         @unique
  indexable   Boolean        @default(true)
  isVisible   Boolean        @default(true)
  sortOrder   Int            @default(0)
  books       BookCategory[]
  // Category hierarchy (self-relation)
  parentId    String?
  parent      Category?       @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[]      @relation("CategoryToCategory")
  translations CategoryTranslation[]
  primaryCategoryVersions BookVersion[] @relation("BookVersionPrimaryCategory")

  @@index([parentId])
}

model BookCategory {
  id            String      @id @default(uuid())
  bookVersionId String
  categoryId    String
  isPrimary     Boolean     @default(false)
  sortOrder     Int         @default(0)
  bookVersion   BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id])

  @@unique([bookVersionId, categoryId])
  @@index([bookVersionId])
  @@index([categoryId])
}

model Tag {
  id        String    @id @default(uuid())
  name      String
  slug      String
  key       String    @unique
  indexable Boolean   @default(true)
  isVisible Boolean   @default(true)
  sortOrder Int       @default(0)
  books     BookTag[]
  translations TagTranslation[]
}

model BookTag {
  id            String      @id @default(uuid())
  bookVersionId String
  tagId         String
  bookVersion   BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id])

  @@unique([bookVersionId, tagId])
  @@index([tagId])
  @@index([bookVersionId])
}

model ViewStat {
  id            String      @id @default(uuid())
  bookVersionId String
  userId        String?
  source        ViewSource
  timestamp     DateTime    @default(now())
  bookVersion   BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id])

  @@index([bookVersionId, timestamp])
  @@index([userId])
}

model ReadingProgress {
  id                 String      @id @default(uuid())
  userId             String
  bookVersionId      String
  chapterNumber      Int?
  audioChapterNumber Int?
  position           Float
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id])
  bookVersion        BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)

  @@unique([userId, bookVersionId])
}

// =====================
// Media Library
// =====================

model MediaAsset {
  id           String   @id @default(uuid())
  key          String   @unique
  url          String
  contentType  String?
  size         Int?
  width        Int?
  height       Int?
  duration     Int?
  hash         String?
  createdAt    DateTime @default(now())
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id])
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  audioChapters AudioChapter[]
  previewVersions BookVersion[] @relation("VersionPreviewMedia")

  @@index([createdAt])
  @@index([hash])
  @@index([isDeleted, deletedAt])
}

// =====================
// CMS Pages
// =====================

model Page {
  id               String      @id @default(uuid())
  slug             String
  title            String
  type             PageType
  content          String
  status           PublicationStatus @default(draft)
  language         Language
  translationGroupId String? @map("translation_group_id") @db.Uuid

  // SEO content fields
  h1               String?
  shortDescription String?   @db.Text
  faq              Json?

  // Homepage-specific sections data (JSON)
  sections         Json?

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  // Optional SEO one-to-one
  seo              Seo?       @relation("SeoForPage", fields: [seoId], references: [id])
  seoId            Int?       @unique

  @@unique([language, slug])
  @@index([language])
  @@index([translationGroupId])
}

// =====================
// SEO model
// =====================

model Seo {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // === Main meta tags ===
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  robots          String?

  // === Open Graph ===
  ogTitle       String?
  ogDescription String?
  ogType        String?
  ogUrl         String?
  ogImageUrl    String?
  ogImageAlt    String?

  // === Twitter Card ===
  twitterCard    String?
  twitterSite    String?
  twitterCreator String?

  // === Event markup (schema.org/Event) ===
  eventName            String?
  eventDescription     String?
  eventStartDate       DateTime?
  eventEndDate         DateTime?
  eventUrl             String?
  eventImageUrl        String?
  eventLocationName    String?
  eventLocationStreet  String?
  eventLocationCity    String?
  eventLocationRegion  String?
  eventLocationPostal  String?
  eventLocationCountry String?

  // Relation to BookVersion (1:1)
  bookVersion BookVersion? @relation("SeoForBookVersion")

  // Relation to Page (1:1)
  page Page? @relation("SeoForPage")

  // Relation to CategoryTranslation (1:1)
  categoryTranslation CategoryTranslation? @relation("SeoForCategoryTranslation")

  // Relation to TagTranslation (1:1)
  tagTranslation TagTranslation? @relation("SeoForTagTranslation")

  // Relation to AuthorTranslation (1:1)
  authorTranslation AuthorTranslation? @relation("SeoForAuthorTranslation")

  // Relation to PersonTranslation (1:1)
  personTranslation PersonTranslation? @relation("SeoForPersonTranslation")
}

model Author {
  id            String              @id @default(uuid())
  birthDate     String?             // Формат YYYY-MM-DD
  deathDate     String?             // Формат YYYY-MM-DD
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  personId      String?
  person        Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)

  translations  AuthorTranslation[]
  bookVersions  BookVersion[]

  @@index([personId])
}

model AuthorTranslation {
  id            String   @id @default(uuid())
  authorId      String
  language      Language
  slug          String
  name          String
  biography     String?  @db.Text
  wikidataUrl   String?
  wikipediaUrl  String?
  photoUrl      String?
  quotes        Json?    // Массив цитат: [{ text: "...", source: "..." }]
  faq           Json?    // Массив вопросов и ответов: [{ question: "...", answer: "..." }]
  similarSlugs  Json?    // Массив слагов похожих авторов: ["oscar-wilde", ...]

  seoId         Int?     @unique
  seo           Seo?     @relation("SeoForAuthorTranslation", fields: [seoId], references: [id], onDelete: SetNull)

  author        Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, language])
  @@unique([language, slug])
}

// =====================
// ENUMS
// =====================

enum Language {
  en
  es
  fr
  pt
  ru
}

enum BookType {
  text
  audio
  referral
}

enum LikeTarget {
  comment
  bookVersion
}

enum CategoryType {
  category
  genre
  collection
}

enum ViewSource {
  text
  audio
  referral
}

// CMS page types
enum PageType {
  generic
  category_index
  author_index
  homepage
}

// =====================
// Taxonomy Translations
// =====================

model CategoryTranslation {
  id               String   @id @default(uuid())
  categoryId       String
  language         Language
  name             String
  slug             String
  description      String?  @db.Text

  // SEO fields
  h1               String?
  shortDescription String?  @db.Text
  metaTitle        String?
  metaDescription  String?  @db.Text
  ogTitle          String?
  ogDescription    String?  @db.Text
  ogImageUrl       String?
  ogImageAlt       String?
  faq              Json?

  seoId            Int?     @unique
  seo              Seo?     @relation("SeoForCategoryTranslation", fields: [seoId], references: [id], onDelete: SetNull)
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([language, slug])
  @@unique([categoryId, language])
  @@index([categoryId])
  @@index([language])
}

model TagTranslation {
  id               String   @id @default(uuid())
  tagId            String
  language         Language
  name             String
  slug             String
  description      String?  @db.Text
  h1               String?
  shortDescription String?  @db.Text
  metaTitle        String?
  metaDescription  String?  @db.Text
  ogTitle          String?
  ogDescription    String?  @db.Text
  ogImageUrl       String?
  ogImageAlt       String?
  canonicalUrl     String?
  robots           String?  @default("index, follow")
  indexable        Boolean  @default(true)
  faq              Json?    // [{question: string, answer: string}]
  relatedTagSlugs  Json?    // string[]
  relatedGenreSlugs Json?   // string[]
  relatedCategorySlugs Json?   // string[]
  relatedCollectionSlugs Json? // string[]
  seoId            Int?     @unique
  seo              Seo?     @relation("SeoForTagTranslation", fields: [seoId], references: [id], onDelete: SetNull)
  tag              Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([language, slug])
  @@unique([tagId, language])
  @@index([tagId])
  @@index([language])
}

// =====================
// Rights Intake (Phase 1)
// =====================

model RightsIntake {
  id String @id @default(uuid())

  candidateTitle   String
  candidateAuthor  String
  originalTitle    String?
  originalLanguage String?
  authorBirthYear  Int?
  authorDeathYear  Int?

  sourceProvider   RightsSourceProvider   @default(UNKNOWN)
  sourceExternalId String?
  sourceUrl        String?
  sourceTitle      String?
  sourceLanguage   String?
  sourceTextType   RightsSourceTextType @default(UNKNOWN)

  targetLanguages     Json
  targetCountryCodes  Json
  plannedContentTypes Json
  plannedComponents   Json?

  notesRu        String?
  workflowStatus RightsIntakeStatus @default(DRAFT)

  createdByUserId String?
  createdByUser   User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewImports   RightsReviewImport[]
  rightsProfiles  RightsProfile[]
  rightsReviewApprovals RightsReviewApproval[]

  approvedReviewId String?
  createdBookId    String? @unique
  createdBook      Book?   @relation("RightsIntakeCreatedBook", fields: [createdBookId], references: [id], onDelete: SetNull)
  archivedAt       DateTime?

  // Phase 6: Back-relation to Book
  book Book? @relation("BookRightsIntake")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowStatus])
  @@index([createdAt])
  @@index([createdByUserId])
}

// =====================
// Rights Review Import (Phase 3)
// =====================

model RightsReviewImport {
  id String @id @default(uuid())

  rightsIntakeId String
  rightsIntake   RightsIntake @relation(fields: [rightsIntakeId], references: [id], onDelete: Cascade)

  schemaVersion String?
  importStatus  RightsReviewImportStatus @default(VALIDATION_FAILED)
  isCurrent     Boolean @default(false)

  reportJson        Json
  reportMarkdown    String?
  rawAgentOutput    String?

  sourceFileName      String?
  reportJsonSha256    String?
  reportMarkdownSha256 String?
  rawAgentOutputSha256 String?

  validationErrors   Json?
  validationWarnings Json?

  importedByUserId String?
  importedByUser   User? @relation(fields: [importedByUserId], references: [id], onDelete: SetNull)
  materializedProfiles RightsProfile[] @relation("ProfileCurrentReviewImport")
  rightsReviews        RightsReview[]

  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rightsIntakeId])
  @@index([importStatus])
  @@index([isCurrent])
  @@index([createdAt])
  @@index([importedByUserId])
}

model RightsProfile {
  id String @id @default(uuid())

  rightsIntakeId String
  rightsIntake RightsIntake @relation(fields: [rightsIntakeId], references: [id], onDelete: Cascade)

  currentReviewImportId String?
  currentReviewImport RightsReviewImport? @relation("ProfileCurrentReviewImport", fields: [currentReviewImportId], references: [id], onDelete: SetNull)

  status RightsProfileStatus @default(IMPORTED)
  isCurrent Boolean @default(true)

  overallStatus RightsOverallStatus
  publicationGate RightsPublicationGate
  confidence RightsConfidence

  summaryRu String @db.Text
  conclusionRu String @db.Text
  reasoningRu String? @db.Text
  nextReviewAt DateTime?

  sourceEdition SourceEdition?
  reviews RightsReview[]
  territoryDecisions TerritoryDecision[]
  components RightsComponent[]
  evidence RightsEvidence[]
  actions RightsAction[]
  approvals RightsReviewApproval[]
  contributors RightsProfileContributor[]

  // Phase 6: Back-relations to Book/BookVersion
  books Book[] @relation("BookCurrentRightsProfile")
  bookVersions BookVersion[] @relation("BookVersionRightsProfile")

  // Phase 8: Content hash & stale detection — fields reserved for future clearance-level
  // content hashing. In Phase 8, the canonical source (content) hash lives on BookVersion
  // (rightsContentHash*). These profile-level fields are defined here for potential future
  // use (e.g., hashing the clearance/rights-rule data itself) but are NOT populated by
  // the current RightsContentHashService.
  contentHash String?
  contentHashAlgorithmVersion String?
  contentHashInput Json?
  contentHashCalculatedAt DateTime?
  staleDetectedAt DateTime?
  staleReasonCode String?
  staleReasonRu String? @db.Text
  contentHashEvents RightsContentHashEvent[]
  geoBlockRules GeoBlockRule[]

  supersededAt DateTime?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rightsIntakeId])
  @@index([currentReviewImportId])
  @@index([status])
  @@index([isCurrent])
  @@index([overallStatus])
  @@index([publicationGate])
  @@index([contentHash])
  @@index([staleDetectedAt])
}

model SourceEdition {
  id String @id @default(uuid())

  rightsProfileId String @unique
  rightsProfile RightsProfile @relation(fields: [rightsProfileId], references: [id], onDelete: Cascade)

  provider RightsSourceProvider @default(UNKNOWN)
  externalId String?
  sourceUrl String?
  sourceTitle String?
  sourceLanguage String?
  sourceTextType RightsSourceTextType @default(UNKNOWN)

  gutenbergStatus String?
  status String
  notesRu String? @db.Text

  editionRights EditionRights?
  contributors  SourceEditionContributor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([externalId])
}

model EditionRights {
  id String @id @default(uuid())

  sourceEditionId String @unique
  sourceEdition SourceEdition @relation(fields: [sourceEditionId], references: [id], onDelete: Cascade)

  status String
  notesRu String? @db.Text
  legalBasisRu String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RightsReview {
  id String @id @default(uuid())

  rightsProfileId String
  rightsProfile RightsProfile @relation(fields: [rightsProfileId], references: [id], onDelete: Cascade)

  rightsReviewImportId String @unique
  rightsReviewImport RightsReviewImport @relation(fields: [rightsReviewImportId], references: [id], onDelete: Cascade)

  status RightsReviewStatus @default(HUMAN_REVIEW_REQUIRED)
  schemaVersion String?
  reviewerType String @default("EXTERNAL_CHATGPT_AGENT")

  overallStatus RightsOverallStatus
  publicationGate RightsPublicationGate
  confidence RightsConfidence

  summaryRu String @db.Text
  conclusionRu String @db.Text
  reasoningRu String? @db.Text
  nextReviewAt DateTime?

  approvedByUserId String?
  approvedByUser User? @relation("RightsReviewApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  approvedAt DateTime?
  approvalNotesRu String? @db.Text

  rejectedByUserId String?
  rejectedByUser User? @relation("RightsReviewRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)

  rejectedAt DateTime?
  rejectionReasonRu String? @db.Text

  approvals RightsReviewApproval[]

  // Phase 6: Back-relations to Book/BookVersion
  approvedBooks Book[] @relation("BookApprovedRightsReview")
  approvedBookVersions BookVersion[] @relation("BookVersionApprovedRightsReview")

  // Phase 8: Content hash & stale detection — fields reserved for future clearance-level
  // content hashing. In Phase 8, the canonical source (content) hash lives on BookVersion
  // (rightsContentHash*). These profile-level fields are defined here for potential future
  // use (e.g., hashing the clearance/rights-rule data itself) but are NOT populated by
  // the current RightsContentHashService.
  contentHash String?
  contentHashAlgorithmVersion String?
  contentHashInput Json?
  contentHashCalculatedAt DateTime?
  staleDetectedAt DateTime?
  staleReasonCode String?
  staleReasonRu String? @db.Text
  contentHashEvents RightsContentHashEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rightsProfileId])
  @@index([status])
  @@index([contentHash])
  @@index([staleDetectedAt])
  @@index([overallStatus])
  @@index([publicationGate])
  @@index([approvedByUserId])
  @@index([rejectedByUserId])
  @@index([approvedAt])
  @@index([rejectedAt])
}

