  url         String?
  sha256      String?
  contentType String?
  sizeBytes   Int?

  notesRu String? @db.Text

  uploadedByUserId String?
  uploadedByUser   User? @relation("RightsClaimAttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

