// =====================
// Phase 17: Agent/API Import Automation
// =====================

enum RightsAgentTokenStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

enum RightsAgentSubmissionStatus {
  /// Запрос принят, обработка ещё не завершена (промежуточное состояние).
  RECEIVED
  /// Отчёт прошёл валидацию, создан RightsReviewImport со статусом VALIDATED.
  VALIDATED
  /// Отчёт принят и сохранён, но валидация нашла ошибки.
  VALIDATION_FAILED
  /// Запрос отклонён до валидации (размер, неподдерживаемая версия схемы, статус интейка).
  REJECTED
  /// Внутренняя ошибка обработки.
  FAILED
}

enum RightsAgentSubmissionMaterialization {
  NOT_ATTEMPTED
  SKIPPED
  SUCCEEDED
  FAILED
}

enum RightsNotificationType {
  AGENT_REPORT_RECEIVED
  AGENT_REPORT_VALIDATION_FAILED
  AGENT_REPORT_MATERIALIZED
  AGENT_REPORT_MATERIALIZATION_FAILED
  AGENT_TOKEN_ISSUED
  AGENT_TOKEN_REVOKED
  HUMAN_REVIEW_REQUIRED
  /// Мост к фазе 18 (Автоматическая перепроверка). В фазе 17 не создаётся.
  RECHECK_DUE
  /// Фаза 18: срок перепроверки прошёл.
  RECHECK_OVERDUE
  /// Фаза 18: открыта задача перепроверки.
  RECHECK_TASK_OPENED
  /// Фаза 18: задача перепроверки закрыта.
  RECHECK_COMPLETED
  /// Фаза 18: применено изменение законодательства.
  LEGAL_CHANGE_APPLIED
  /// Мост к фазе 19 (Lawyer Workflow). С фазы 19 создаётся при открытии юридической проверки.
  LAWYER_REVIEW_REQUIRED
  OTHER
  /// Фаза 19: юристу назначена проверка.
  LAWYER_REVIEW_ASSIGNED
  /// Фаза 19: юрист вынес положительное заключение.
  LAWYER_REVIEW_APPROVED
  /// Фаза 19: юрист отказал.
  LAWYER_REVIEW_REJECTED
  /// Фаза 19: юридическая проверка отозвана.
  LAWYER_REVIEW_WITHDRAWN
  /// Фаза 19: срок действия заключения истекает.
  LAWYER_OPINION_EXPIRING
  /// Фаза 19: срок действия заключения истёк.
  LAWYER_OPINION_EXPIRED
}

enum RightsNotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model RightsAgentUploadToken {
  id String @id @default(uuid())

  rightsIntakeId String
  rightsIntake   RightsIntake @relation(fields: [rightsIntakeId], references: [id], onDelete: Cascade)

  /// sha256(hex) от полного токена. Сам токен нигде не сохраняется.
  tokenHash String @unique
  /// Первые 12 символов токена — только для отображения в админке ("brat_AbCdEfG…").
  tokenPrefix String

  status RightsAgentTokenStatus @default(ACTIVE)

  /// Человекочитаемая пометка редактора ("для ChatGPT-агента, попытка 2").
  labelRu String?

  /// Версии схемы отчёта, которые принимает этот токен. null = все поддерживаемые.
  allowedSchemaVersions Json?

  /// Сколько успешных сабмишенов разрешено. По умолчанию 1 — одноразовый токен.
  maxUses   Int @default(1)
  usedCount Int @default(0)

  /// Неуспешные попытки (провал валидации при allowRetryOnValidationError = true).
  failedAttempts    Int @default(0)
  maxFailedAttempts Int @default(5)

  /// true — провал валидации НЕ расходует использование токена, агент может исправиться и прислать снова.
  allowRetryOnValidationError Boolean @default(true)

  /// true — после успешной валидации сразу материализовать профиль и создать черновую проверку.
  autoMaterialize Boolean @default(true)

  expiresAt DateTime

  issuedByUserId String?
  issuedByUser   User? @relation("RightsAgentTokenIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  firstUsedAt       DateTime?
  lastUsedAt        DateTime?
  lastUsedIp        String?
  lastUsedUserAgent String?

  revokedAt       DateTime?
  revokedByUserId String?
  revokedByUser   User? @relation("RightsAgentTokenRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  revokeReasonRu  String? @db.Text

  submissions RightsAgentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rightsIntakeId])
  @@index([status])
  @@index([expiresAt])
  @@index([issuedByUserId])
  @@index([revokedByUserId])
  @@index([createdAt])
}

model RightsAgentSubmission {
  id String @id @default(uuid())

  rightsIntakeId String
  rightsIntake   RightsIntake @relation(fields: [rightsIntakeId], references: [id], onDelete: Cascade)

  uploadTokenId String?
  uploadToken   RightsAgentUploadToken? @relation(fields: [uploadTokenId], references: [id], onDelete: SetNull)

  status RightsAgentSubmissionStatus @default(RECEIVED)

  /// Версия схемы, заявленная в теле отчёта (может быть неподдерживаемой).
  declaredSchemaVersion String?

  reportJsonSha256 String?
  payloadSizeBytes Int?
  sourceFileName   String?

  /// Самоидентификация агента из тела запроса — доверия к ней нет, только аудит.
  agentName    String?
  agentVersion String?

  submittedIp        String?
  submittedUserAgent String?

  /// Созданная запись импорта (если запрос дошёл до создания импорта).
  rightsReviewImportId String?
  rightsReviewImport   RightsReviewImport? @relation("AgentSubmissionImport", fields: [rightsReviewImportId], references: [id], onDelete: SetNull)

  validationErrorCount   Int @default(0)
  validationWarningCount Int @default(0)

  /// Код отказа, если status = REJECTED/FAILED.
  rejectionCode      String?
  rejectionMessageRu String? @db.Text

  materialization       RightsAgentSubmissionMaterialization @default(NOT_ATTEMPTED)
  materializationError  String? @db.Text
  materializedProfileId String?

  processedAt DateTime?
  createdAt   DateTime @default(now())

  notifications RightsNotification[]

  @@index([rightsIntakeId])
  @@index([uploadTokenId])
  @@index([status])
  @@index([rightsReviewImportId])
  @@index([reportJsonSha256])
  @@index([createdAt])
}

model RightsNotification {
  id String @id @default(uuid())

  type     RightsNotificationType
  severity RightsNotificationSeverity @default(INFO)

  titleRu   String
  messageRu String @db.Text

  /// null = уведомление для всех админов/контент-менеджеров.
  targetUserId String?
  targetUser   User? @relation("RightsNotificationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  rightsIntakeId String?
  rightsIntake   RightsIntake? @relation(fields: [rightsIntakeId], references: [id], onDelete: Cascade)

  agentSubmissionId String?
  agentSubmission   RightsAgentSubmission? @relation(fields: [agentSubmissionId], references: [id], onDelete: SetNull)

  /// Навигационные ссылки без внешних ключей: удаление цели не должно удалять уведомление.
  rightsReviewImportId String?
  rightsProfileId      String?
  bookVersionId        String?

  /// Дополнительные данные для UI (счётчики ошибок, коды и т.п.).
  payload Json?

  isRead       Boolean   @default(false)
  readAt       DateTime?
  readByUserId String?
  readByUser   User? @relation("RightsNotificationReadBy", fields: [readByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([type])
  @@index([severity])
  @@index([targetUserId, isRead])
  @@index([isRead])
  @@index([rightsIntakeId])
  @@index([agentSubmissionId])
  @@index([createdAt])
  @@index([readByUserId])
}

// =====================
// Phase 18: Automatic Recheck
// =====================

enum RightsRecheckReason {
  /// Наступил (или приближается) плановый срок nextReviewAt.
  SCHEDULED_DUE
  /// Изменился контент версии — сработал content hash фазы 8.
  CONTENT_CHANGED
  /// Изменились rights-данные / source edition в снимке версии.
  RIGHTS_DATA_CHANGED
  /// К книге добавлена новая языковая версия.
  LANGUAGE_ADDED
  /// Добавлены или изменены аудио-главы.
  AUDIO_ADDED
  /// Добавлен или изменён компонент прав.
  COMPONENT_ADDED
  /// Объявлено изменение законодательства в затронутой юрисдикции.
  LEGAL_CHANGE
  /// Проверка помечена STALE (профиль или ревью).
  REVIEW_STALE
  /// Ручной запрос редактора.
  MANUAL_REQUEST
  OTHER
}

enum RightsRecheckStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

enum RightsRecheckSeverity {
  /// Информационная: срок ещё не наступил.
  INFO
  /// Срок наступил либо контент изменился — редактору пора действовать.
  WARNING
  /// Просрочка за пределами grace-периода или критичное изменение закона.
  BLOCKING
}

enum RightsRecheckReminderStage {
  NONE
  LEAD_30
  LEAD_7
  DUE
  OVERDUE
  ESCALATED
}

enum RightsRecheckResolution {
  /// Пришла и утверждена новая проверка.
  NEW_REVIEW_APPROVED
  /// Появилась более свежая утверждённая проверка — задача закрыта автоматически.
  SUPERSEDED_BY_NEW_REVIEW
  /// Проверено, изменений не требуется.
  NO_CHANGE_NEEDED
  /// Контент возвращён к состоянию на момент clearance.
  CONTENT_REVERTED
  /// Закрыто вручную редактором.
  MANUALLY_CLOSED
  /// Отклонено как неприменимое.
  DISMISSED_NOT_APPLICABLE
  OTHER
}

enum RightsRecheckTriggerSource {
  SCHEDULER
  CONTENT_HASH
  VERSION_CREATED
  LEGAL_CHANGE
  MANUAL
}

enum RightsRecheckEventType {
  TASK_CREATED
  REMINDER_SENT
  SEVERITY_ESCALATED
  SNOOZED
  STARTED
  COMPLETED
  DISMISSED
  REOPENED
  DUE_DATE_CHANGED
  LINKED_TO_REVIEW
  NOTE_ADDED
}

enum RightsRecheckPolicy {
  /// Дата берётся из nextReviewAt отчёта агента (текущее поведение).
  INHERIT_REPORT
  /// Дата считается как approvedAt + recheckIntervalDays.
  FIXED_INTERVAL
  /// Плановые задачи не создаются, только событийные.
  MANUAL_ONLY
  /// Плановые задачи приостановлены до recheckPausedUntil.
  PAUSED
}

enum RightsLegalChangeType {
  COPYRIGHT_TERM_CHANGE
  PUBLIC_DOMAIN_RULE_CHANGE
  TRANSLATION_RIGHTS_CHANGE
  NEIGHBOURING_RIGHTS_CHANGE
  COURT_DECISION
  TREATY_RATIFICATION
  PLATFORM_POLICY_CHANGE
  OTHER
}

enum RightsLegalChangeStatus {
  DRAFT
  APPLIED
  ARCHIVED
}

enum RightsRecheckScanStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model RightsLegalChangeEvent {
  id String @id @default(uuid())

  titleRu       String
  descriptionRu String @db.Text

  changeType RightsLegalChangeType
  status     RightsLegalChangeStatus @default(DRAFT)
  severity   RightsRecheckSeverity   @default(WARNING)

  /// Затронутые юрисдикции (ISO-2). Игнорируется, если appliesToAllCountries = true.
  jurisdictionCodes Json
  /// true — изменение затрагивает все страны (например, международный договор).
  appliesToAllCountries Boolean @default(false)

  /// Дата вступления в силу. Если задана и в будущем — dueAt задач равен ей.
  effectiveFrom DateTime?

  sourceUrl   String?
  sourceTitle String?

  appliedAt             DateTime?
  appliedByUserId       String?
  appliedByUser         User? @relation("RightsLegalChangeAppliedBy", fields: [appliedByUserId], references: [id], onDelete: SetNull)
  affectedProfilesCount Int @default(0)
  createdTasksCount     Int @default(0)

  archivedAt DateTime?

  createdByUserId String?
  createdByUser   User? @relation("RightsLegalChangeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  recheckTasks RightsRecheckTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([changeType])
  @@index([effectiveFrom])
  @@index([createdAt])
  @@index([appliedByUserId])
  @@index([createdByUserId])
}

model RightsRecheckTask {
  id String @id @default(uuid())

  reason   RightsRecheckReason
  status   RightsRecheckStatus @default(PENDING)
  severity RightsRecheckSeverity @default(INFO)
  source   RightsRecheckTriggerSource @default(SCHEDULER)

  /// Цель перепроверки. Профиль — основной адресат; интейк и книга/версия — для навигации и фильтров.
  rightsProfileId String?
  rightsProfile   RightsProfile? @relation(fields: [rightsProfileId], references: [id], onDelete: Cascade)

  rightsIntakeId String?
  rightsIntake   RightsIntake? @relation(fields: [rightsIntakeId], references: [id], onDelete: Cascade)

  /// Проверка, относительно которой задача считается актуальной («baseline»).
  baselineReviewId String?
  baselineReview   RightsReview? @relation("RightsRecheckBaselineReview", fields: [baselineReviewId], references: [id], onDelete: SetNull)

  bookId String?
  book   Book? @relation(fields: [bookId], references: [id], onDelete: Cascade)

  bookVersionId String?
  bookVersion   BookVersion? @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)

  legalChangeEventId String?
  legalChangeEvent   RightsLegalChangeEvent? @relation(fields: [legalChangeEventId], references: [id], onDelete: SetNull)

  titleRu       String
  descriptionRu String @db.Text
  /// Машиночитаемая причина: для CONTENT_CHANGED сюда кладётся BookVersion.rightsStaleReasonCode.
  triggerCode   String?
  /// Затронутые страны (для LEGAL_CHANGE). Массив ISO-2.
  affectedCountryCodes Json?

  dueAt DateTime

  reminderStage    RightsRecheckReminderStage @default(NONE)
  remindersSentCount Int @default(0)
  lastReminderAt   DateTime?

  snoozedUntil   DateTime?
  snoozeReasonRu String? @db.Text

  startedAt       DateTime?
  startedByUserId String?
  startedByUser   User? @relation("RightsRecheckStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)

  completedAt       DateTime?
  completedByUserId String?
  completedByUser   User? @relation("RightsRecheckCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  completionNotesRu String? @db.Text
  /// Проверка, закрывшая задачу.
  completedReviewId String?
  completedReview   RightsReview? @relation("RightsRecheckCompletedReview", fields: [completedReviewId], references: [id], onDelete: SetNull)

  dismissedAt       DateTime?
  dismissedByUserId String?
  dismissedByUser   User? @relation("RightsRecheckDismissedBy", fields: [dismissedByUserId], references: [id], onDelete: SetNull)
  dismissReasonRu   String? @db.Text

  resolution RightsRecheckResolution?

  createdByUserId String?
  createdByUser   User? @relation("RightsRecheckCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  events RightsRecheckEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([reason])
  @@index([severity])
  @@index([dueAt])
  @@index([rightsProfileId, status])
  @@index([rightsIntakeId])
  @@index([bookVersionId, status])
  @@index([bookId])
  @@index([legalChangeEventId])
  @@index([baselineReviewId])
  @@index([completedReviewId])
  @@index([createdAt])
  @@index([startedByUserId])
  @@index([completedByUserId])
  @@index([dismissedByUserId])
  @@index([createdByUserId])
}

model RightsRecheckEvent {
  id String @id @default(uuid())

  recheckTaskId String
  recheckTask   RightsRecheckTask @relation(fields: [recheckTaskId], references: [id], onDelete: Cascade)

  eventType RightsRecheckEventType

  fromStatus RightsRecheckStatus?
  toStatus   RightsRecheckStatus?

  messageRu String  @db.Text
  payload   Json?

  createdByUserId String?
  createdByUser   User? @relation("RightsRecheckEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([recheckTaskId])
  @@index([eventType])
  @@index([createdAt])
  @@index([createdByUserId])
}

model RightsRecheckScanRun {
  id String @id @default(uuid())

  status RightsRecheckScanStatus @default(RUNNING)
  /// SCHEDULER — авто-прогон, MANUAL — кнопка в админке.
  source RightsRecheckTriggerSource @default(SCHEDULER)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  profilesScanned  Int @default(0)
  versionsScanned  Int @default(0)
  tasksCreated     Int @default(0)
  tasksEscalated   Int @default(0)
  tasksAutoClosed  Int @default(0)
  remindersSent    Int @default(0)

  errorMessage String? @db.Text

  triggeredByUserId String?
  triggeredByUser   User? @relation("RightsRecheckScanTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([startedAt])
  @@index([triggeredByUserId])
}

// =====================
// Lawyer Workflow (Phase 19)
// =====================

/// Уровень юридического риска профиля прав. Порядок — по возрастанию.
enum RightsRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Тип юриста в справочнике.
enum RightsLawyerType {
  IN_HOUSE
  EXTERNAL_COUNSEL
  LAW_FIRM
  OTHER
}

/// Статус юридической проверки.
enum RightsLawyerReviewStatus {
  /// Создана, юрист не назначен или ещё не приступил.
  PENDING
  /// Юрист взял в работу.
  IN_PROGRESS
  /// Положительное заключение без условий.
  APPROVED
  /// Положительное заключение с обязательными условиями.
  APPROVED_WITH_CONDITIONS
  /// Отказ.
  REJECTED
  /// Отозвана редактором до вынесения решения либо после (с причиной).
  WITHDRAWN
  /// Срок действия заключения истёк.
  EXPIRED
}

/// Решение юриста. Отдельный enum, чтобы не путать статус процесса и вердикт.
enum RightsLawyerDecision {
  APPROVED
  APPROVED_WITH_CONDITIONS
  REJECTED
}

/// Почему потребовалась юридическая проверка.
enum RightsLawyerReviewTrigger {
  /// В отчёте агента есть RightsAction типа LAWYER_REVIEW.
  AGENT_REQUESTED
  /// Автоматическая оценка риска дала уровень >= порога.
  HIGH_RISK_POLICY
  /// Ручной запрос редактора.
  MANUAL_REQUEST
  /// Претензия правообладателя (фаза 16).
  RIGHTS_CLAIM
  /// Изменение законодательства (фаза 18).
  LEGAL_CHANGE
  /// Требуется лицензия на территорию.
  LICENSE_REQUIRED
  OTHER
}

/// Тип юридического заключения.
enum RightsLegalOpinionKind {
  EXTERNAL_COUNSEL_MEMO
  IN_HOUSE_MEMO
  EMAIL_CONFIRMATION
  COURT_FILING
  REGULATOR_RESPONSE
  OTHER
}

/// Статус обязательного условия из заключения юриста.
enum RightsLawyerConditionStatus {
  PENDING
  SATISFIED
  WAIVED
}

/// Тип записи в неудаляемом аудите юридической проверки.
enum RightsLawyerReviewEventType {
  REQUESTED
  ASSIGNED
  UNASSIGNED
  STARTED
  OPINION_ATTACHED
  OPINION_ARCHIVED
  CONDITION_ADDED
  CONDITION_SATISFIED
  CONDITION_WAIVED
  DECIDED
  WITHDRAWN
  REOPENED
  EXPIRED
  DUE_DATE_CHANGED
  NOTE_ADDED
}

/// Справочник юристов и юридических организаций. Физического удаления нет — только deactivate.
model RightsLawyer {
  id String @id @default(uuid())

  fullName     String
  lawyerType   RightsLawyerType @default(EXTERNAL_COUNSEL)
  organization String?
  /// Регистрационный номер / номер в реестре адвокатов.
  barId String?
  email String?
  phone String?
  /// Список ISO 3166-1 alpha-2 кодов юрисдикций, в которых юрист компетентен.
  jurisdictionCodes Json
  /// Специализация свободным текстом (копирайт, смежные права, издательское право).
  specializationRu String? @db.Text
  notesRu          String? @db.Text

  /// Необязательная привязка к пользователю платформы с ролью lawyer.
  /// Только привязанный юрист может выносить решение сам; иначе решение вносит админ от его имени.
  userId String? @unique
  user   User?   @relation("RightsLawyerUser", fields: [userId], references: [id], onDelete: SetNull)

  isActive            Boolean   @default(true)
  deactivatedAt       DateTime?
  deactivatedByUserId String?
  deactivatedByUser   User?     @relation("RightsLawyerDeactivatedBy", fields: [deactivatedByUserId], references: [id], onDelete: SetNull)
  deactivateReasonRu  String?   @db.Text

  createdByUserId String?
  createdByUser   User?   @relation("RightsLawyerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  reviews  RightsLawyerReview[]
  opinions RightsLegalOpinion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([lawyerType])
  @@index([fullName])
  @@index([userId])
  @@index([createdByUserId])
}

model RightsLawyerReview {
  id String @id @default(uuid())

  /// Человекочитаемый номер вида LR-2026-000123, уникальный.
  reviewNumber String @unique

  status  RightsLawyerReviewStatus  @default(PENDING)
  trigger RightsLawyerReviewTrigger
  /// Снимок уровня риска на момент создания проверки.
  riskLevel RightsRiskLevel @default(HIGH)
  /// Снимок факторов риска: [{ code, level, messageRu, details? }].
  riskFactors Json?

  /// Полиморфные цели. Хотя бы одна из rightsProfileId / rightsIntakeId обязательна.
  rightsProfileId String?
  rightsProfile   RightsProfile? @relation(fields: [rightsProfileId], references: [id], onDelete: Cascade)

  rightsIntakeId String?
  rightsIntake   RightsIntake? @relation(fields: [rightsIntakeId], references: [id], onDelete: Cascade)

  /// Проверка агента, из-за которой возникла эскалация.
  rightsReviewId String?
  rightsReview   RightsReview? @relation("RightsLawyerReviewSubject", fields: [rightsReviewId], references: [id], onDelete: SetNull)

  bookId String?
  book   Book?   @relation("BookLawyerReviews", fields: [bookId], references: [id], onDelete: SetNull)

  bookVersionId String?
  bookVersion   BookVersion? @relation("BookVersionLawyerReviews", fields: [bookVersionId], references: [id], onDelete: SetNull)

  /// Навигационная ссылка на претензию (фаза 16). БЕЗ внешнего ключа и без relation:
  /// модуль претензий в фазе 19 не меняется, а каскады не должны связывать два домена.
  rightsClaimId String?

  titleRu String
  /// Что именно должен решить юрист.
  questionRu String @db.Text
  /// Контекст: сводка профиля, спорные компоненты, ссылки.
  contextRu String? @db.Text

  affectedCountryCodes Json
  affectedLanguages    Json
  /// id спорных RightsComponent — навигационный список без FK.
  affectedComponentIds Json?

  /// Блокирует ли эта проверка approve интейка и публикацию версий.
  blocksApproval Boolean @default(true)

  requestedByUserId String?
  requestedByUser   User?     @relation("RightsLawyerReviewRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  requestedAt       DateTime  @default(now())
  dueAt             DateTime?

  assignedLawyerId String?
  assignedLawyer   RightsLawyer? @relation(fields: [assignedLawyerId], references: [id], onDelete: SetNull)
  assignedAt       DateTime?
  assignedByUserId String?
  assignedByUser   User?         @relation("RightsLawyerReviewAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  startedAt DateTime?

  decision  RightsLawyerDecision?
  decidedAt DateTime?
  /// Пользователь, физически внёсший решение (юрист или админ от его имени).
  decidedByUserId String?
  decidedByUser   User?   @relation("RightsLawyerReviewDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  /// Юрист, которому принадлежит заключение (может отличаться от decidedByUser).
  decidedLawyerId String?
  /// Снимок имени юриста на момент решения. Требование roadmap lawyer name.
  /// Именно снимок: переименование записи в справочнике не должно переписывать историю.
  lawyerNameSnapshot String?

  opinionSummaryRu String? @db.Text
  /// Ограничения, которые юрист требует соблюдать (страны, форматы, аудио).
  restrictionsRu       String? @db.Text
  approvedCountryCodes Json?
  blockedCountryCodes  Json?

  /// Срок действия заключения. null = бессрочно.
  validUntil DateTime?
  expiredAt  DateTime?
  /// Когда по этой проверке в последний раз отправлялось уведомление об истечении.
  /// Нужен для идемпотентности ручного скана.
  expiryNotifiedAt DateTime?

  withdrawnAt       DateTime?
  withdrawnByUserId String?
  withdrawnByUser   User?     @relation("RightsLawyerReviewWithdrawnBy", fields: [withdrawnByUserId], references: [id], onDelete: SetNull)
  withdrawReasonRu  String?   @db.Text

  reopenedAt       DateTime?
  reopenedByUserId String?
  reopenedByUser   User?     @relation("RightsLawyerReviewReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: SetNull)

  opinions   RightsLegalOpinion[]
  conditions RightsLawyerReviewCondition[]
  events     RightsLawyerReviewEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([trigger])
  @@index([riskLevel])
  @@index([decision])
  @@index([rightsProfileId])
  @@index([rightsIntakeId])
  @@index([rightsReviewId])
  @@index([bookId])
  @@index([bookVersionId])
  @@index([rightsClaimId])
  @@index([assignedLawyerId])
  @@index([dueAt])
  @@index([validUntil])
  @@index([blocksApproval])
  @@index([createdAt])
  @@index([requestedByUserId])
  @@index([assignedByUserId])
  @@index([decidedByUserId])
  @@index([withdrawnByUserId])
  @@index([reopenedByUserId])
}

/// Документ заключения. Физического удаления нет — только archive (soft).
model RightsLegalOpinion {
  id String @id @default(uuid())

  rightsLawyerReviewId String
  rightsLawyerReview   RightsLawyerReview @relation(fields: [rightsLawyerReviewId], references: [id], onDelete: Cascade)

  kind    RightsLegalOpinionKind @default(EXTERNAL_COUNSEL_MEMO)
  titleRu String
  /// Текст заключения или его существенная выдержка.
  bodyRu String @db.Text

  lawyerId String?
  lawyer   RightsLawyer? @relation(fields: [lawyerId], references: [id], onDelete: SetNull)
  /// Снимок имени на момент прикрепления.
  lawyerNameSnapshot String?

  documentUrl       String?
  documentSha256    String?
  fileName          String?
  mimeType          String?
  issuedAt          DateTime?
  jurisdictionCodes Json?

  /// Автоматически созданная запись доказательства (evidenceType = LEGAL_OPINION).
  /// Создаётся только если у проверки известен rightsProfileId.
  rightsEvidenceId String?         @unique
  rightsEvidence   RightsEvidence? @relation(fields: [rightsEvidenceId], references: [id], onDelete: SetNull)

  uploadedByUserId String?
  uploadedByUser   User?   @relation("RightsLegalOpinionUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  archivedAt       DateTime?
  archivedByUserId String?
  archivedByUser   User?     @relation("RightsLegalOpinionArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  archiveReasonRu  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rightsLawyerReviewId])
  @@index([kind])
  @@index([lawyerId])
  @@index([documentSha256])
  @@index([archivedAt])
  @@index([uploadedByUserId])
  @@index([archivedByUserId])
}

/// Обязательное условие из положительного заключения с условиями.
/// Пока есть хотя бы одно PENDING-условие, publication gate блокирует публикацию.
model RightsLawyerReviewCondition {
  id String @id @default(uuid())

  rightsLawyerReviewId String
  rightsLawyerReview   RightsLawyerReview @relation(fields: [rightsLawyerReviewId], references: [id], onDelete: Cascade)

  /// Машинный код условия для UI и gate: REMOVE_ILLUSTRATIONS, GEO_BLOCK_US, ATTRIBUTION_TEXT.
  code   String
  textRu String                      @db.Text
  status RightsLawyerConditionStatus @default(PENDING)
  /// Условие, невыполнение которого блокирует публикацию. false = рекомендация.
  isBlocking Boolean @default(true)

  affectedCountryCodes Json?

  satisfiedAt       DateTime?
  satisfiedByUserId String?
  satisfiedByUser   User?     @relation("RightsLawyerConditionSatisfiedBy", fields: [satisfiedByUserId], references: [id], onDelete: SetNull)
  satisfiedNotesRu  String?   @db.Text

  waivedAt       DateTime?
  waivedByUserId String?
  waivedByUser   User?     @relation("RightsLawyerConditionWaivedBy", fields: [waivedByUserId], references: [id], onDelete: SetNull)
  waiveReasonRu  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rightsLawyerReviewId])
  @@index([status])
  @@index([isBlocking])
  @@index([satisfiedByUserId])
  @@index([waivedByUserId])
}

model RightsLawyerReviewEvent {
  id String @id @default(uuid())

  rightsLawyerReviewId String
  rightsLawyerReview   RightsLawyerReview @relation(fields: [rightsLawyerReviewId], references: [id], onDelete: Cascade)

  eventType  RightsLawyerReviewEventType
  fromStatus RightsLawyerReviewStatus?
  toStatus   RightsLawyerReviewStatus?

  messageRu String @db.Text
  payload   Json?

  createdByUserId String?
  createdByUser   User?   @relation("RightsLawyerReviewEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([rightsLawyerReviewId])
  @@index([eventType])
  @@index([createdAt])
  @@index([createdByUserId])
}
