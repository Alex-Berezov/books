// Phase 8: Content hash & stale detection
enum RightsContentChangeTrigger {
  INITIAL_VERSION_SNAPSHOT
  BOOK_VERSION_UPDATED
  CHAPTER_CREATED
  CHAPTER_UPDATED
  CHAPTER_DELETED
  AUDIO_CHAPTER_CREATED
  AUDIO_CHAPTER_UPDATED
  AUDIO_CHAPTER_DELETED
  AUDIO_CHAPTER_REORDERED
  RIGHTS_SNAPSHOT_CHANGED
  SOURCE_EDITION_CHANGED
  REVIEW_IMPORT_CHANGED
  MANUAL_HASH_CHECK
}

model RightsContentHashEvent {
  id String @id @default(uuid())

  bookVersionId String?
  bookVersion BookVersion? @relation(fields: [bookVersionId], references: [id], onDelete: SetNull)

  rightsProfileId String?
  rightsProfile RightsProfile? @relation(fields: [rightsProfileId], references: [id], onDelete: SetNull)

  rightsReviewId String?
  rightsReview RightsReview? @relation(fields: [rightsReviewId], references: [id], onDelete: SetNull)

  trigger RightsContentChangeTrigger

  previousHash String?
  currentHash String?
  hashAlgorithmVersion String

  staleMarked Boolean @default(false)

  reasonCode String?
  reasonRu String? @db.Text

  createdByUserId String?
  createdByUser User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([bookVersionId])
  @@index([rightsProfileId])
  @@index([rightsReviewId])
  @@index([trigger])
  @@index([staleMarked])
  @@index([createdAt])
}

// Phase 12: Runtime GeoIP market blocking projection
enum GeoBlockScope {
  ENTIRE_BOOK
  LANGUAGE_EDITION
  TEXT_READER
  DOWNLOADS
  AUDIO
  SPECIFIC_ASSET
}

model GeoBlockRule {
  id String @id @default(uuid())

  bookId String?
  book Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)

  bookVersionId String?
  bookVersion BookVersion? @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)

  rightsProfileId String?
  rightsProfile RightsProfile? @relation(fields: [rightsProfileId], references: [id], onDelete: Cascade)

  territoryDecisionId String?
  territoryDecision TerritoryDecision? @relation(fields: [territoryDecisionId], references: [id], onDelete: SetNull)

  scope GeoBlockScope
  countryCode String

  accessPolicy RightsAccessPolicy
  sourceFinalStatus TerritoryRightsStatus?

  isActive Boolean @default(true)

  reasonRu String? @db.Text
  legalBasisRu String? @db.Text

  generatedFrom String @default("TERRITORY_DECISION")
  generatedAt DateTime @default(now())

  verifiedAt DateTime?
  verifiedByUserId String?
  verifiedByUser User? @relation("GeoBlockRuleVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verificationNotesRu String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
  @@index([bookVersionId])
  @@index([rightsProfileId])
  @@index([territoryDecisionId])
  @@index([countryCode])
  @@index([scope])
  @@index([isActive])
  @@index([verifiedByUserId])
  @@unique([bookVersionId, scope, countryCode])
}

