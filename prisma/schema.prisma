datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// =====================
// Main entities
// =====================

model Book {
  id        String        @id @default(uuid())
  slug      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  versions  BookVersion[]
  ratings   BookRating[]
  geoBlockRules GeoBlockRule[]

  // Phase 6: Rights clearance links
  rightsIntakeId String? @unique
  rightsIntake RightsIntake? @relation("BookRightsIntake", fields: [rightsIntakeId], references: [id], onDelete: SetNull)

  currentRightsProfileId String?
  currentRightsProfile RightsProfile? @relation("BookCurrentRightsProfile", fields: [currentRightsProfileId], references: [id], onDelete: SetNull)

  approvedRightsReviewId String?
  approvedRightsReview RightsReview? @relation("BookApprovedRightsReview", fields: [approvedRightsReviewId], references: [id], onDelete: SetNull)

  rightsCreatedAt DateTime?

  // Phase 6: Back-relation to RightsIntake (createdBook)
  sourceRightsIntake RightsIntake? @relation("RightsIntakeCreatedBook")

  // Phase 16: Rights claims / DMCA
  rightsClaims            RightsClaim[]
  rightsClaimAccessBlocks RightsClaimAccessBlock[] @relation("RightsClaimBlockBook")

  // Phase 18: automatic recheck
  recheckTasks RightsRecheckTask[]

  // Phase 19: lawyer workflow
  lawyerReviews RightsLawyerReview[] @relation("BookLawyerReviews")

  @@index([rightsIntakeId])
  @@index([currentRightsProfileId])
  @@index([approvedRightsReviewId])
}

model BookVersion {
  id              String            @id @default(uuid())
  bookId          String
  language        Language
  title           String
  author          String
  description     String
  coverImageUrl   String
  type            BookType
  isFree          Boolean
  referralUrl     String?
  slug            String?
  // Publication
  status          PublicationStatus @default(published)
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  book            Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  summaries       BookSummary[]
  chapters        Chapter[]
  audioChapters   AudioChapter[]
  bookshelf       Bookshelf[]
  comments        Comment[]
  likes           Like[]
  categories      BookCategory[]
  tags            BookTag[]
  viewStats       ViewStat[]
  readingProgress ReadingProgress[]
  seo             Seo?              @relation("SeoForBookVersion", fields: [seoId], references: [id])
  seoId           Int?              @unique
  previewMedia    MediaAsset?       @relation("VersionPreviewMedia", fields: [previewMediaId], references: [id], onDelete: SetNull)
  previewMediaId  String?
  primaryCategoryId String?
  primaryCategory   Category?       @relation("BookVersionPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  firstPublishedYear    Int?
  editionPublishedYear  Int?
  originalLanguage      String?
  copyrightStatus       String?
  authorPageUrl         String?
  authorId              String?
  authorRelation        Author?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  characters            Json?
  quotes                Json?
  faq                   Json?
  themes                Json?
  originalTitle         String?
  alternativeTitles     Json?
  shortDescription      String?
  summaryShort          String?
  symbols               Json?
  coverAlt              String?

  // Phase 6: Rights snapshot
  rightsProfileId String?
  rightsProfile RightsProfile? @relation("BookVersionRightsProfile", fields: [rightsProfileId], references: [id], onDelete: SetNull)

  approvedRightsReviewId String?
  approvedRightsReview RightsReview? @relation("BookVersionApprovedRightsReview", fields: [approvedRightsReviewId], references: [id], onDelete: SetNull)

  rightsStatus String?
  rightsAllowedCountryCodes Json?
  rightsBlockedCountryCodes Json?
  rightsLicenseRequiredCountryCodes Json?
  rightsPendingCountryCodes Json?
  rightsRequiredActions Json?

  // Phase 7: Publication gate geo-block fields
  rightsGeoBlockRequired Boolean @default(false)
  rightsGeoBlockConfigured Boolean @default(false)
  rightsGeoBlockConfiguredAt DateTime?
  rightsGeoBlockNotesRu String?
  rightsGeoBlockVerifiedAt DateTime?
  rightsGeoBlockVerifiedByUserId String?
  rightsGeoBlockVerifiedBy User? @relation("BookVersionGeoBlockVerifiedBy", fields: [rightsGeoBlockVerifiedByUserId], references: [id], onDelete: SetNull)
  rightsGeoBlockLastGeneratedAt DateTime?
  geoBlockRules GeoBlockRule[]

  // Phase 8: Content hash & stale detection
  rightsContentHash String?
  rightsContentHashAlgorithmVersion String?
  rightsContentHashInput Json?
  rightsContentHashCalculatedAt DateTime?
  rightsRecheckRequired Boolean @default(false)
  rightsStaleDetectedAt DateTime?
  rightsStaleReasonCode String?
  rightsStaleReasonRu String? @db.Text
  rightsContentHashEvents RightsContentHashEvent[]

  // Phase 15: License snapshot
  rightsLicenseIds Json?
  rightsLicenseCoverageStatus String?
  rightsLicenseCheckedAt DateTime?
  rightsLicenseUncoveredCountryCodes Json?
  rightsLicenseAttributionTextRu String? @db.Text

  contributors BookVersionContributor[]
  licenseLinks RightsLicenseLink[]

  // Phase 16: Rights claims snapshot
  /// Denormalised flag: the version is covered by an active rights-claim access block.
  /// Maintained in the same transaction as apply/lift; RightsClaimAccessBlock stays the source of truth.
  rightsClaimBlockActive Boolean @default(false)
  rightsClaimBlockAppliedAt DateTime?

  rightsClaims            RightsClaim[]
  rightsClaimAccessBlocks RightsClaimAccessBlock[] @relation("RightsClaimBlockVersion")

  // Phase 18: automatic recheck
  recheckTasks RightsRecheckTask[]

  // Phase 19: lawyer workflow
  lawyerReviews RightsLawyerReview[] @relation("BookVersionLawyerReviews")

  @@unique([bookId, language])
  @@unique([language, slug])
  @@index([bookId, language, type, isFree], name: "book_language_type_isFree_idx")
  @@index([previewMediaId])
  @@index([primaryCategoryId])
  @@index([authorId])
  @@index([rightsProfileId])
  @@index([approvedRightsReviewId])
  @@index([rightsContentHash])
  @@index([rightsRecheckRequired])
  @@index([rightsStaleDetectedAt])
  @@index([rightsGeoBlockVerifiedByUserId])
  @@index([rightsLicenseCoverageStatus])
  @@index([rightsClaimBlockActive])
  // LEGACY-272. Строковая половина связи автора с книгами
  // (`bv.author = t.name`) в `PUBLISHED_BOOKS_JOIN`. Без индекса планировщик
  // соединяет две таблицы по одному `language` и отбрасывает `OR` фильтром
  // соединения: на 25 000 переводов и 20 000 версий это 19 996 000
  // отброшенных строк и около секунды на каждый из трёх запросов хаба.
  // С индексом `OR` раскладывается в `BitmapOr` двух индексных обходов
  // (второй - существующий `authorId`), и переписывать запрос в `UNION`,
  // как предполагал пункт 3 записи, не требуется.
  @@index([author, language, status])
}

model BookSummary {
  id            String      @id @default(uuid())
  bookVersionId String
  summary       String
  analysis      String?
  themes        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  bookVersion   BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
}

model Chapter {
  id            String      @id @default(uuid())
  bookVersionId String
  number        Int
  title         String
  content       String
  createdAt     DateTime    @default(now())
  bookVersion   BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
  comments      Comment[]

  @@unique([bookVersionId, number])
}

model AudioChapter {
  id            String      @id @default(uuid())
  bookVersionId String
  number        Int
  title         String
  audioUrl      String
  duration      Int
  description   String?
  transcript    String?
  mediaId       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  bookVersion   BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
  media         MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  comments      Comment[]

  @@unique([bookVersionId, number])
  @@index([mediaId])
}

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  passwordHash       String?
  name               String?
  firstName          String?
  lastName           String?
  nickname           String?           @unique
  isActive           Boolean           @default(true)
  avatarUrl          String?
  languagePreference Language
  createdAt          DateTime          @default(now())
  lastLogin          DateTime?
  bookshelves        Bookshelf[]
  comments           Comment[]
  likes              Like[]
  viewStats          ViewStat[]
  readingProgress    ReadingProgress[]
  roles              UserRole[]
  identities         UserIdentity[]
  ratings            BookRating[]
  mediaAssets        MediaAsset[]
  rightsIntakes      RightsIntake[]
  rightsReviewImports RightsReviewImport[]
  approvedRightsReviews RightsReview[] @relation("RightsReviewApprovedBy")
  rejectedRightsReviews RightsReview[] @relation("RightsReviewRejectedBy")
  rightsReviewApprovals RightsReviewApproval[]
  rightsContentHashEvents RightsContentHashEvent[]
  verifiedGeoBlockRules GeoBlockRule[] @relation("GeoBlockRuleVerifiedBy")
  verifiedGeoBlockVersions BookVersion[] @relation("BookVersionGeoBlockVerifiedBy")
  rightsLicensesCreated RightsLicense[] @relation("RightsLicenseCreatedBy")
  rightsLicensesRevoked RightsLicense[] @relation("RightsLicenseRevokedBy")
  rightsLicenseLinksCreated RightsLicenseLink[] @relation("RightsLicenseLinkCreatedBy")
  rightsLicenseEventsCreated RightsLicenseEvent[] @relation("RightsLicenseEventCreatedBy")
  rightsClaimsCreated RightsClaim[] @relation("RightsClaimCreatedBy")
  rightsClaimsAssigned RightsClaim[] @relation("RightsClaimAssignedTo")
  rightsClaimsResponded RightsClaim[] @relation("RightsClaimRespondedBy")
  rightsClaimsResolved RightsClaim[] @relation("RightsClaimResolvedBy")
  rightsClaimBlocksApplied RightsClaimAccessBlock[] @relation("RightsClaimBlockAppliedBy")
  rightsClaimBlocksLifted RightsClaimAccessBlock[] @relation("RightsClaimBlockLiftedBy")
  rightsClaimAttachmentsUploaded RightsClaimAttachment[] @relation("RightsClaimAttachmentUploadedBy")
  rightsClaimAttachmentsRemoved RightsClaimAttachment[] @relation("RightsClaimAttachmentRemovedBy")
  rightsClaimEventsCreated RightsClaimEvent[] @relation("RightsClaimEventCreatedBy")
  rightsAgentTokensIssued  RightsAgentUploadToken[] @relation("RightsAgentTokenIssuedBy")
  rightsAgentTokensRevoked RightsAgentUploadToken[] @relation("RightsAgentTokenRevokedBy")
  rightsNotifications      RightsNotification[]     @relation("RightsNotificationTarget")
  rightsNotificationsRead  RightsNotification[]     @relation("RightsNotificationReadBy")
  rightsRecheckTasksCreated   RightsRecheckTask[]      @relation("RightsRecheckCreatedBy")
  rightsRecheckTasksStarted   RightsRecheckTask[]      @relation("RightsRecheckStartedBy")
  rightsRecheckTasksCompleted RightsRecheckTask[]      @relation("RightsRecheckCompletedBy")
  rightsRecheckTasksDismissed RightsRecheckTask[]      @relation("RightsRecheckDismissedBy")
  rightsRecheckEventsCreated  RightsRecheckEvent[]     @relation("RightsRecheckEventCreatedBy")
  rightsLegalChangesCreated   RightsLegalChangeEvent[] @relation("RightsLegalChangeCreatedBy")
  rightsLegalChangesApplied   RightsLegalChangeEvent[] @relation("RightsLegalChangeAppliedBy")
  rightsRecheckScanRuns       RightsRecheckScanRun[]   @relation("RightsRecheckScanTriggeredBy")
  rightsLawyerProfile         RightsLawyer?                @relation("RightsLawyerUser")
  rightsLawyersCreated        RightsLawyer[]               @relation("RightsLawyerCreatedBy")
  rightsLawyersDeactivated    RightsLawyer[]               @relation("RightsLawyerDeactivatedBy")
  lawyerReviewsRequested      RightsLawyerReview[]         @relation("RightsLawyerReviewRequestedBy")
  lawyerReviewsAssigned       RightsLawyerReview[]         @relation("RightsLawyerReviewAssignedBy")
  lawyerReviewsDecided        RightsLawyerReview[]         @relation("RightsLawyerReviewDecidedBy")
  lawyerReviewsWithdrawn      RightsLawyerReview[]         @relation("RightsLawyerReviewWithdrawnBy")
  lawyerReviewsReopened       RightsLawyerReview[]         @relation("RightsLawyerReviewReopenedBy")
  lawyerReviewEventsCreated   RightsLawyerReviewEvent[]    @relation("RightsLawyerReviewEventCreatedBy")
  legalOpinionsUploaded       RightsLegalOpinion[]         @relation("RightsLegalOpinionUploadedBy")
  legalOpinionsArchived       RightsLegalOpinion[]         @relation("RightsLegalOpinionArchivedBy")
  lawyerConditionsSatisfied   RightsLawyerReviewCondition[] @relation("RightsLawyerConditionSatisfiedBy")
  lawyerConditionsWaived      RightsLawyerReviewCondition[] @relation("RightsLawyerConditionWaivedBy")
  rightsActionsAssigned       RightsAction[]               @relation("RightsActionAssignedTo")
  rightsActionsCompleted      RightsAction[]               @relation("RightsActionCompletedBy")
  rightsActionEventsCreated   RightsActionEvent[]          @relation("RightsActionEventCreatedBy")
  rightsReportPdfsUploaded    RightsReviewImport[]         @relation("RightsReportPdfUploadedBy")
  rightsSourceFilesUploaded   SourceEdition[]              @relation("RightsSourceFileUploadedBy")
  rightsEvidenceArchived      RightsEvidence[]             @relation("RightsEvidenceArchivedBy")
  profileContributorEvents    RightsProfileContributorEvent[] @relation("RightsProfileContributorEventCreatedBy")
}



model Bookshelf {
  id            String      @id @default(uuid())
  userId        String
  bookVersionId String
  addedAt       DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id])
  bookVersion   BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)

  @@unique([userId, bookVersionId])
}

model Comment {
  id             String        @id @default(uuid())
  userId         String
  bookVersionId  String?
  chapterId      String?
  audioChapterId String?
  parentId       String?
  ratingId       String?       @unique
  text           String
  isDeleted      Boolean       @default(false)
  isHidden       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id])
  bookVersion    BookVersion?  @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
  chapter        Chapter?      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  audioChapter   AudioChapter? @relation(fields: [audioChapterId], references: [id], onDelete: Cascade)
  rating         BookRating?   @relation(fields: [ratingId], references: [id], onDelete: SetNull)
  parent         Comment?      @relation("CommentParent", fields: [parentId], references: [id])
  children       Comment[]     @relation("CommentParent")
  likes          Like[]

  @@index([bookVersionId])
  @@index([chapterId])
  @@index([audioChapterId])
  @@index([parentId])
}

model Like {
  id            String       @id @default(uuid())
  userId        String
  bookVersionId String? // FK to BookVersion
  commentId     String? // FK to Comment
  isLike        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id])
  bookVersion   BookVersion? @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
  comment       Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@unique([userId, bookVersionId])
  @@index([commentId])
  @@index([bookVersionId])
}

model Category {
  id          String         @id @default(uuid())
  type        CategoryType
  name        String
  slug        String
  key         String         @unique
  indexable   Boolean        @default(true)
  isVisible   Boolean        @default(true)
  sortOrder   Int            @default(0)
  books       BookCategory[]
  // Category hierarchy (self-relation)
  parentId    String?
  parent      Category?       @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[]      @relation("CategoryToCategory")
  translations CategoryTranslation[]
  primaryCategoryVersions BookVersion[] @relation("BookVersionPrimaryCategory")

  @@index([parentId])
}

model BookCategory {
  id            String      @id @default(uuid())
  bookVersionId String
  categoryId    String
  isPrimary     Boolean     @default(false)
  sortOrder     Int         @default(0)
  bookVersion   BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id])

  @@unique([bookVersionId, categoryId])
  @@index([bookVersionId])
  @@index([categoryId])
}

model Tag {
  id        String    @id @default(uuid())
  name      String
  slug      String
  key       String    @unique
  indexable Boolean   @default(true)
  isVisible Boolean   @default(true)
  sortOrder Int       @default(0)
  books     BookTag[]
  translations TagTranslation[]
}

model BookTag {
  id            String      @id @default(uuid())
  bookVersionId String
  tagId         String
  bookVersion   BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id])

  @@unique([bookVersionId, tagId])
  @@index([tagId])
  @@index([bookVersionId])
}

model ViewStat {
  id            String      @id @default(uuid())
  bookVersionId String
  userId        String?
  source        ViewSource
  timestamp     DateTime    @default(now())
  bookVersion   BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id])

  @@index([bookVersionId, timestamp])
  @@index([userId])
}

model ReadingProgress {
  id                 String      @id @default(uuid())
  userId             String
  bookVersionId      String
  chapterNumber      Int?
  audioChapterNumber Int?
  position           Float
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id])
  bookVersion        BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)

  @@unique([userId, bookVersionId])
}

// =====================
// Media Library
// =====================

model MediaAsset {
  id           String   @id @default(uuid())
  key          String   @unique
  url          String
  contentType  String?
  size         Int?
  width        Int?
  height       Int?
  duration     Int?
  hash         String?
  createdAt    DateTime @default(now())
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id])
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  audioChapters AudioChapter[]
  previewVersions BookVersion[] @relation("VersionPreviewMedia")
  rightsLicenseDocuments RightsLicense[] @relation("RightsLicenseDocument")
  rightsClaimMediaAssets RightsClaim[] @relation("RightsClaimMediaAsset")
  rightsClaimAttachments RightsClaimAttachment[] @relation("RightsClaimAttachment")

  @@index([createdAt])
  @@index([hash])
  @@index([isDeleted, deletedAt])
}

// =====================
// CMS Pages
// =====================

model Page {
  id               String      @id @default(uuid())
  slug             String
  title            String
  type             PageType
  content          String
  status           PublicationStatus @default(draft)
  language         Language
  translationGroupId String? @map("translation_group_id") @db.Uuid

  /// Неизменяемая опора для страниц, которые ищет сам сайт: `homepage` и четыре
  /// хаба таксономий. До 09.08.2026 их находили по слагу — редактируемому полю,
  /// которое генерируется из заголовка. Правка заголовка рвала связь, и это не
  /// давало ошибки: главная переходила на словарные строки, а хабы молча теряли
  /// metaTitle, metaDescription, h1, SEO-текст и FAQ.
  ///
  /// NULL — у обычных страниц; редактору поле недоступно вовсе (в DTO его нет,
  /// а `forbidNonWhitelisted` отвечает на попытку прислать его 400).
  systemKey        String?    @map("system_key")

  // SEO content fields
  h1               String?
  shortDescription String?   @db.Text
  faq              Json?

  // Homepage-specific sections data (JSON)
  sections         Json?

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  // Optional SEO one-to-one
  seo              Seo?       @relation("SeoForPage", fields: [seoId], references: [id])
  seoId            Int?       @unique

  @@unique([language, slug])
  /// ⚠️ Уникальность **составная**, а не глобальная, как записано в
  /// `tasks/system-pages-slug/TASK.md` §A2. Системная страница существует один
  /// раз **в каждом языке** — пять строк на ключ. Глобальный `@unique` пустил бы
  /// в базу только одну из них и сломал бы бэкфилл на второй же строке.
  /// NULL в Postgres не равен NULL, поэтому обычные страницы ограничение не
  /// задевает: их сколько угодно на язык.
  @@unique([language, systemKey])
  @@index([language])
  @@index([translationGroupId])
}

// =====================
// SEO model
// =====================

model Seo {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // === Main meta tags ===
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  robots          String?

  // === Open Graph ===
  ogTitle       String?
  ogDescription String?
  ogType        String?
  ogUrl         String?
  ogImageUrl    String?
  ogImageAlt    String?

  // === Twitter Card ===
  twitterCard    String?
  twitterSite    String?
  twitterCreator String?

  // === Event markup (schema.org/Event) ===
  eventName            String?
  eventDescription     String?
  eventStartDate       DateTime?
  eventEndDate         DateTime?
  eventUrl             String?
  eventImageUrl        String?
  eventLocationName    String?
  eventLocationStreet  String?
  eventLocationCity    String?
  eventLocationRegion  String?
  eventLocationPostal  String?
  eventLocationCountry String?

  // Relation to BookVersion (1:1)
  bookVersion BookVersion? @relation("SeoForBookVersion")

  // Relation to Page (1:1)
  page Page? @relation("SeoForPage")

  // Relation to CategoryTranslation (1:1)
  categoryTranslation CategoryTranslation? @relation("SeoForCategoryTranslation")

  // Relation to TagTranslation (1:1)
  tagTranslation TagTranslation? @relation("SeoForTagTranslation")

  // Relation to AuthorTranslation (1:1)
  authorTranslation AuthorTranslation? @relation("SeoForAuthorTranslation")

  // Relation to PersonTranslation (1:1)
  personTranslation PersonTranslation? @relation("SeoForPersonTranslation")
}

model Author {
  id            String              @id @default(uuid())
  birthDate     String?             // Формат YYYY-MM-DD
  deathDate     String?             // Формат YYYY-MM-DD
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  personId      String?
  person        Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)

  translations  AuthorTranslation[]
  bookVersions  BookVersion[]

  @@index([personId])
}

model AuthorTranslation {
  id            String   @id @default(uuid())
  authorId      String
  language      Language
  slug          String
  name          String
  biography     String?  @db.Text
  wikidataUrl   String?
  wikipediaUrl  String?
  photoUrl      String?
  quotes        Json?    // Массив цитат: [{ text: "...", source: "..." }]
  faq           Json?    // Массив вопросов и ответов: [{ question: "...", answer: "..." }]
  similarSlugs  Json?    // Массив слагов похожих авторов: ["oscar-wilde", ...]

  seoId         Int?     @unique
  seo           Seo?     @relation("SeoForAuthorTranslation", fields: [seoId], references: [id], onDelete: SetNull)

  author        Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, language])
  @@unique([language, slug])
  // LEGACY-272. Внешняя сторона того же join'а плюс порядок публичного списка.
  // Сам по себе связь не ускоряет (`total` и буквы остаются на секунде), но
  // даёт `ORDER BY t.name` уже отсортированный вход: страница хаба падает
  // с 36 мс до 0,4 мс на том же объёме.
  @@index([language, name])
}

// =====================
// ENUMS
// =====================

enum Language {
  en
  es
  fr
  pt
  ru
}

enum BookType {
  text
  audio
  referral
}

enum LikeTarget {
  comment
  bookVersion
}

enum CategoryType {
  category
  genre
  collection
}

enum ViewSource {
  text
  audio
  referral
}

// CMS page types
enum PageType {
  generic
  category_index
  author_index
  homepage
}

// =====================
// Taxonomy Translations
// =====================

/// История слагов публичных сущностей (LEGACY-062).
///
/// Слаг таксономии — индексируемый публичный URL. До появления этой таблицы
/// `update()` перезаписывал его на месте: прошлое значение исчезало без следа, а
/// старый адрес немедленно начинал отдавать 404 — без 301, без переноса сигналов,
/// без возможности узнать, каким URL был раньше.
///
/// `@@unique([entityType, language, oldSlug])` — один старый адрес ведёт ровно в
/// одно место. Цепочки (A→B→C) при записи схлопываются до A→C, иначе браузер шёл бы
/// по цепочке редиректов, а Google учитывал бы только несколько первых звеньев.
model SlugRedirect {
  id         String   @id @default(uuid())
  /// 'category' | 'tag'. Строка, а не enum: сюда лягут страницы, книги и авторы,
  /// и добавление типа не должно требовать миграции enum.
  entityType String
  language   Language
  oldSlug    String
  newSlug    String
  createdAt  DateTime @default(now())

  @@unique([entityType, language, oldSlug])
  @@index([entityType, language, newSlug])
}

model CategoryTranslation {
  id               String   @id @default(uuid())
  categoryId       String
  language         Language
  name             String
  slug             String
  description      String?  @db.Text

  // SEO fields
  h1               String?
  shortDescription String?  @db.Text
  metaTitle        String?
  metaDescription  String?  @db.Text
  ogTitle          String?
  ogDescription    String?  @db.Text
  ogImageUrl       String?
  ogImageAlt       String?
  faq              Json?

  // Automatic indexability (see modules/seo/indexability/taxonomyIndexability.ts).
  // bookCount is the cached number of published books in this language;
  // autoIndexable is the hysteresis state derived from it. Both are recomputed
  // by TaxonomyIndexabilityService, never on the fly.
  bookCount        Int      @default(0)
  autoIndexable    Boolean  @default(true)

  seoId            Int?     @unique
  seo              Seo?     @relation("SeoForCategoryTranslation", fields: [seoId], references: [id], onDelete: SetNull)
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([language, slug])
  @@unique([categoryId, language])
  @@index([categoryId])
  @@index([language])
  @@index([language, autoIndexable])
}

model TagTranslation {
  id               String   @id @default(uuid())
  tagId            String
  language         Language
  name             String
  slug             String
  description      String?  @db.Text
  h1               String?
  shortDescription String?  @db.Text
  metaTitle        String?
  metaDescription  String?  @db.Text
  ogTitle          String?
  ogDescription    String?  @db.Text
  ogImageUrl       String?
  ogImageAlt       String?
  canonicalUrl     String?
  robots           String?  @default("index, follow")
  indexable        Boolean  @default(true)
  faq              Json?    // [{question: string, answer: string}]
  relatedTagSlugs  Json?    // string[]
  relatedGenreSlugs Json?   // string[]
  relatedCategorySlugs Json?   // string[]
  relatedCollectionSlugs Json? // string[]

  // Automatic indexability — see CategoryTranslation for the contract.
  bookCount        Int      @default(0)
  autoIndexable    Boolean  @default(true)

  seoId            Int?     @unique
  seo              Seo?     @relation("SeoForTagTranslation", fields: [seoId], references: [id], onDelete: SetNull)
  tag              Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([language, slug])
  @@unique([tagId, language])
  @@index([tagId])
  @@index([language])
  @@index([language, autoIndexable])
}

// =====================
// Rights Intake (Phase 1)
// =====================

model RightsIntake {
  id String @id @default(uuid())

  candidateTitle   String
  candidateAuthor  String
  originalTitle    String?
  originalLanguage String?
  authorBirthYear  Int?
  authorDeathYear  Int?

  sourceProvider   RightsSourceProvider   @default(UNKNOWN)
  sourceExternalId String?
  sourceUrl        String?
  sourceTitle      String?
  sourceLanguage   String?
  sourceTextType   RightsSourceTextType @default(UNKNOWN)

  targetLanguages     Json
  targetCountryCodes  Json
  plannedContentTypes Json
  plannedComponents   Json?

  notesRu        String?
  workflowStatus RightsIntakeStatus @default(DRAFT)

  createdByUserId String?
  createdByUser   User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewImports   RightsReviewImport[]
  rightsProfiles  RightsProfile[]
  rightsReviewApprovals RightsReviewApproval[]

  approvedReviewId String?
  createdBookId    String? @unique
  createdBook      Book?   @relation("RightsIntakeCreatedBook", fields: [createdBookId], references: [id], onDelete: SetNull)
  archivedAt       DateTime?

  // Phase 6: Back-relation to Book
  book Book? @relation("BookRightsIntake")

  // Phase 16: Rights claims / DMCA
  rightsClaims RightsClaim[]

  // Phase 17: Agent/API import automation
  agentUploadTokens   RightsAgentUploadToken[]
  agentSubmissions    RightsAgentSubmission[]
  rightsNotifications RightsNotification[]

  // Phase 18: automatic recheck
  recheckTasks RightsRecheckTask[]

  // Phase 19: lawyer workflow
  lawyerReviews RightsLawyerReview[]

  /// WP-9.1 (R4-02): снимок манифеста, отданного агенту. Манифест собирается на лету и
  /// содержит `generatedAt`, поэтому повторный GET даёт другие байты — сохраняются ровно те,
  /// которые ушли агенту. Импорт копирует эти три поля в `inputManifest*`, отвечая на вопрос
  /// «под каким заданием сделан этот отчёт». Файл лежит в приватном хранилище прав.
  manifestStorageKey  String?
  manifestSha256      String?
  manifestVersion     String?
  manifestGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowStatus])
  @@index([createdAt])
  @@index([createdByUserId])
}

// =====================
// Rights Review Import (Phase 3)
// =====================

model RightsReviewImport {
  id String @id @default(uuid())

  rightsIntakeId String
  rightsIntake   RightsIntake @relation(fields: [rightsIntakeId], references: [id], onDelete: Cascade)

  schemaVersion String?
  importStatus  RightsReviewImportStatus @default(VALIDATION_FAILED)
  isCurrent     Boolean @default(false)

  reportJson        Json
  reportMarkdown    String?
  rawAgentOutput    String?

  sourceFileName      String?
  reportJsonSha256    String?
  reportMarkdownSha256 String?
  rawAgentOutputSha256 String?

  /// WP-9.1 (R4-02, essence §15): архивные копии текстовых артефактов отчёта в приватном
  /// хранилище прав. Источником истины остаётся `reportJson` в БД — ключи нужны, чтобы
  /// юридический пакет можно было выгрузить целиком, а не собирать из колонок.
  /// Запись best-effort: недоступность хранилища не отменяет импорт, ключ остаётся `null`.
  reportJsonStorageKey     String?
  reportMarkdownStorageKey String?
  rawAgentOutputStorageKey String?

  /// WP-9.2 (R4-02): PDF-отчёт — требование roadmap фазы 3, не реализованное ни одной из
  /// 20 фаз. Публичный URL не сохраняется и не отдаётся: файл скачивается только через
  /// админский эндпоинт под ролями Admin/ContentManager.
  reportPdfStorageKey       String?
  reportPdfSha256           String?
  reportPdfFileName         String?
  reportPdfContentType      String?
  reportPdfSizeBytes        Int?
  reportPdfUploadedAt       DateTime?
  reportPdfUploadedByUserId String?
  reportPdfUploadedByUser   User? @relation("RightsReportPdfUploadedBy", fields: [reportPdfUploadedByUserId], references: [id], onDelete: SetNull)

  /// WP-9.1 (essence §15): снимок задания, под которое агент писал отчёт. Копируется из
  /// `RightsIntake.manifest*` в момент импорта, поэтому переиздание манифеста задним числом
  /// не меняет того, что было у уже принятого отчёта.
  inputManifestStorageKey String?
  inputManifestSha256     String?
  inputManifestVersion    String?

  /// WP-9.1 (essence §15): версия задания и самоидентификация агента. `promptVersion` —
  /// версия манифеста, `agentModel` — то, чем агент себя назвал (`agentName`/`agentVersion`
  /// агентского канала, audit only). В ручном канале заполняются редактором.
  promptVersion String?
  agentModel    String?

  validationErrors   Json?
  validationWarnings Json?

  importedByUserId String?
  importedByUser   User? @relation(fields: [importedByUserId], references: [id], onDelete: SetNull)
  materializedProfiles RightsProfile[] @relation("ProfileCurrentReviewImport")
  rightsReviews        RightsReview[]
  agentSubmissions     RightsAgentSubmission[] @relation("AgentSubmissionImport")

  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rightsIntakeId])
  @@index([importStatus])
  @@index([isCurrent])
  @@index([createdAt])
  @@index([importedByUserId])
  @@index([reportPdfSha256])
  @@index([reportPdfUploadedByUserId])
}

model RightsProfile {
  id String @id @default(uuid())

  rightsIntakeId String
  rightsIntake RightsIntake @relation(fields: [rightsIntakeId], references: [id], onDelete: Cascade)

  currentReviewImportId String?
  currentReviewImport RightsReviewImport? @relation("ProfileCurrentReviewImport", fields: [currentReviewImportId], references: [id], onDelete: SetNull)

  status RightsProfileStatus @default(IMPORTED)
  isCurrent Boolean @default(true)

  overallStatus RightsOverallStatus
  publicationGate RightsPublicationGate
  confidence RightsConfidence

  summaryRu String @db.Text
  conclusionRu String @db.Text
  reasoningRu String? @db.Text
  nextReviewAt DateTime?

  // Phase 18: политика автоматической перепроверки
  recheckPolicy       RightsRecheckPolicy @default(INHERIT_REPORT)
  recheckIntervalDays Int?
  recheckPausedUntil  DateTime?
  recheckPauseReasonRu String? @db.Text
  lastRecheckScanAt   DateTime?

  sourceEdition SourceEdition?
  reviews RightsReview[]
  territoryDecisions TerritoryDecision[]
  components RightsComponent[]
  evidence RightsEvidence[]
  actions RightsAction[]
  approvals RightsReviewApproval[]
  contributors RightsProfileContributor[]
  contributorEvents RightsProfileContributorEvent[]
  licenseLinks RightsLicenseLink[]

  // Phase 6: Back-relations to Book/BookVersion
  books Book[] @relation("BookCurrentRightsProfile")
  bookVersions BookVersion[] @relation("BookVersionRightsProfile")

  // Phase 8: устаревание клиренса. Канонический хеш контента живёт на `BookVersion`
  // (`rightsContentHash*`) — здесь только отметка «этот профиль признан устаревшим»,
  // которую ставит `RightsContentHashService.markStale`.
  //
  // WP-10.4 (R3-07): четыре зеркальных колонки хеша (`contentHash`,
  // `contentHashAlgorithmVersion`, `contentHashInput`, `contentHashCalculatedAt`) удалены
  // миграцией `20260802010000`. Они были заведены «на будущее», ни одна строка кода их
  // не писала и не читала, а `RightsProfile.contentHash` рядом с настоящим
  // `BookVersion.rightsContentHash` — ловушка: прочитавший его получит `null`
  // и решит, что хеша нет.
  staleDetectedAt DateTime?
  staleReasonCode String?
  staleReasonRu String? @db.Text
  contentHashEvents RightsContentHashEvent[]
  geoBlockRules GeoBlockRule[]

  // Phase 16: Rights claims / DMCA
  rightsClaims RightsClaim[]

  // Phase 18: automatic recheck
  recheckTasks RightsRecheckTask[]

  // Phase 19: снимок оценки риска и юридического утверждения
  riskLevel      RightsRiskLevel @default(LOW)
  /// [{ code, level, messageRu, details? }] — снимок факторов на момент riskAssessedAt.
  riskFactors    Json?
  riskAssessedAt DateTime?

  /// Требуется ли юридическая проверка перед обычным утверждением.
  lawyerReviewRequired Boolean @default(false)
  /// Есть ли открытая проверка с blocksApproval = true.
  lawyerReviewBlocking Boolean @default(false)
  currentLawyerReviewId String?
  lawyerApprovedAt      DateTime?
  lawyerApprovedLawyerId String?
  /// Снимок имени юриста, чьё положительное заключение действует.
  lawyerApprovedLawyerName String?
  /// Срок действия действующего заключения. null = бессрочно.
  lawyerOpinionValidUntil DateTime?

  lawyerReviews RightsLawyerReview[]

  supersededAt DateTime?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rightsIntakeId])
  @@index([currentReviewImportId])
  @@index([status])
  @@index([isCurrent])
  @@index([overallStatus])
  @@index([publicationGate])
  @@index([staleDetectedAt])
  @@index([nextReviewAt])
  @@index([recheckPolicy])
  @@index([riskLevel])
  @@index([lawyerReviewRequired])
  @@index([lawyerReviewBlocking])
  @@index([lawyerApprovedAt])
}

model SourceEdition {
  id String @id @default(uuid())

  rightsProfileId String @unique
  rightsProfile RightsProfile @relation(fields: [rightsProfileId], references: [id], onDelete: Cascade)

  provider RightsSourceProvider @default(UNKNOWN)
  externalId String?
  sourceUrl String?
  sourceTitle String?
  sourceLanguage String?
  sourceTextType RightsSourceTextType @default(UNKNOWN)

  gutenbergStatus String?
  status String
  notesRu String? @db.Text

  /// WP-9.1 / WP-8.3 (R3-05): сам файл источника. До этого хешировались только метаданные —
  /// подмена файла по тому же адресу оставалась невидимой для клиренса (тот же класс, что
  /// R1-04 у обложки). В content hash входит **только** `sourceFileSha256`; ключ, имя, MIME
  /// и размер — сопровождение файла и на клиренс не влияют (ADR-010).
  sourceFileStorageKey       String?
  sourceFileSha256           String?
  sourceFileName             String?
  sourceFileContentType      String?
  sourceFileSizeBytes        Int?
  sourceFileUploadedAt       DateTime?
  sourceFileUploadedByUserId String?
  sourceFileUploadedByUser   User? @relation("RightsSourceFileUploadedBy", fields: [sourceFileUploadedByUserId], references: [id], onDelete: SetNull)

  editionRights EditionRights[]
  licenseLinks RightsLicenseLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([externalId])
  @@index([sourceFileSha256])
  @@index([sourceFileUploadedByUserId])
}

/// WP-7.1 (R2-01, R3-01): права языковой версии — запись на язык, а не 1:1-довесок к
/// исходному изданию. `status`/`notesRu` теперь несут вердикт агента по этому языку
/// (`languageAssessments[]` отчёта), а не копию полей `SourceEdition`.
model EditionRights {
  id String @id @default(uuid())

  sourceEditionId String
  sourceEdition SourceEdition @relation(fields: [sourceEditionId], references: [id], onDelete: Cascade)

  /// Код целевого языка издания (`SUPPORTED_LANGS`). Значение проверяется валидатором импорта.
  languageCode String

  status String
  notesRu String? @db.Text
  legalBasisRu String? @db.Text

  /// Происхождение текста на этом языке: оригинал, перевод Bibliaris, сторонний перевод.
  translationOrigin String @default("UNKNOWN")
  /// Язык, с которого сделан перевод. Заполнен только для промежуточных переводов.
  translationSourceLanguage String?
  /// Требование геоблокировки, заявленное агентом на уровне языка.
  requiresGeoBlock Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceEditionId, languageCode])
  @@index([languageCode])
}

model RightsReview {
  id String @id @default(uuid())

  rightsProfileId String
  rightsProfile RightsProfile @relation(fields: [rightsProfileId], references: [id], onDelete: Cascade)

  rightsReviewImportId String @unique
  rightsReviewImport RightsReviewImport @relation(fields: [rightsReviewImportId], references: [id], onDelete: Cascade)

  status RightsReviewStatus @default(HUMAN_REVIEW_REQUIRED)
  schemaVersion String?
  reviewerType String @default("EXTERNAL_CHATGPT_AGENT")

  /// WP-9.1 (essence §15): снимок «под каким заданием и чем проверяли». Копируется из импорта
  /// при материализации тем же приёмом, что и `schemaVersion`: проверка — акт, и она обязана
  /// нести эти сведения сама, даже если импорт потом станет `SUPERSEDED`.
  /// Файлы отчёта на проверку **не дублируются** — они живут на `RightsReviewImport`,
  /// связанном через `rightsReviewImportId @unique` (отступление от essence §15 осознанное:
  /// вторая копия тех же путей повторила бы судьбу мёртвых `contentHash*`-колонок).
  promptVersion String?
  agentModel    String?

  overallStatus RightsOverallStatus
  publicationGate RightsPublicationGate
  confidence RightsConfidence

  summaryRu String @db.Text
  conclusionRu String @db.Text
  reasoningRu String? @db.Text
  nextReviewAt DateTime?

  // Phase 18: история проверок
  previousReviewId String?  @unique
  previousReview   RightsReview?  @relation("RightsReviewChain", fields: [previousReviewId], references: [id], onDelete: SetNull)
  nextReview       RightsReview?  @relation("RightsReviewChain")
  /// Корень цепочки — id самой первой проверки интейка. У первой проверки равен её собственному id.
  chainRootReviewId String?
  /// Порядковый номер в цепочке, начиная с 1.
  revisionNumber Int @default(1)

  approvedByUserId String?
  approvedByUser User? @relation("RightsReviewApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  approvedAt DateTime?
  approvalNotesRu String? @db.Text

  rejectedByUserId String?
  rejectedByUser User? @relation("RightsReviewRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)

  rejectedAt DateTime?
  rejectionReasonRu String? @db.Text

  approvals RightsReviewApproval[]

  // Phase 6: Back-relations to Book/BookVersion
  approvedBooks Book[] @relation("BookApprovedRightsReview")
  approvedBookVersions BookVersion[] @relation("BookVersionApprovedRightsReview")

  // Phase 8: устаревание клиренса. Канонический хеш контента живёт на `BookVersion`
  // (`rightsContentHash*`) — здесь только отметка «эта проверка признана устаревшей»,
  // которую ставит `RightsContentHashService.markStale` вместе со статусом `STALE`.
  //
  // WP-10.4 (R3-07): четыре зеркальных колонки хеша удалены миграцией `20260802010000` —
  // обоснование то же, что и у `RightsProfile`.
  staleDetectedAt DateTime?
  staleReasonCode String?
  staleReasonRu String? @db.Text
  contentHashEvents RightsContentHashEvent[]

  // Phase 18: automatic recheck
  recheckTasksAsBaseline  RightsRecheckTask[] @relation("RightsRecheckBaselineReview")
  recheckTasksAsCompleted RightsRecheckTask[] @relation("RightsRecheckCompletedReview")

  // Phase 19: юридическое утверждение
  lawyerReviewRequired Boolean   @default(false)
  lawyerReviewId       String?
  lawyerApprovedAt     DateTime?
  lawyerNameSnapshot   String?

  lawyerReviews RightsLawyerReview[] @relation("RightsLawyerReviewSubject")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rightsProfileId])
  @@index([status])
  @@index([lawyerReviewId])
  @@index([staleDetectedAt])
  @@index([overallStatus])
  @@index([publicationGate])
  @@index([approvedByUserId])
  @@index([rejectedByUserId])
  @@index([approvedAt])
  @@index([rejectedAt])
  @@index([chainRootReviewId])
  @@index([revisionNumber])
}

model RightsComponent {
  id String @id @default(uuid())

  rightsProfileId String
  rightsProfile RightsProfile @relation(fields: [rightsProfileId], references: [id], onDelete: Cascade)

  componentType RightsComponentType
  titleRu String
  /// WP-7.2 (R3-01): язык, к которому относится компонент. `null` — компонент общий для всех
  /// языков версии (например, обложка); заполненное значение несёт перевод и переводчика.
  languageCode String?
  status RightsComponentStatus
  requiredAction RightsComponentRequiredAction
  confidence RightsConfidence
  notesRu String? @db.Text

  territoryAssessments ComponentTerritoryAssessment[]
  contributors         RightsProfileContributor[]
  licenseLinks         RightsLicenseLink[]
  claimComponents      RightsClaimComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rightsProfileId])
  @@index([componentType])
  @@index([languageCode])
  @@index([status])
}

model TerritoryDecision {
  id String @id @default(uuid())

  rightsProfileId String
  rightsProfile RightsProfile @relation(fields: [rightsProfileId], references: [id], onDelete: Cascade)

  countryCode String
  finalStatus TerritoryRightsStatus
  accessPolicy RightsAccessPolicy
  geoBlockRequired Boolean @default(false)
  geoBlockScope String?

  reasonRu String @db.Text
  legalBasisRu String? @db.Text
  confidence RightsConfidence
  nextReviewAt DateTime?
  geoBlockRules GeoBlockRule[]
  licenseLinks RightsLicenseLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rightsProfileId, countryCode])
  @@index([rightsProfileId])
  @@index([countryCode])
  @@index([finalStatus])
  @@index([accessPolicy])
  @@index([geoBlockRequired])
}

model ComponentTerritoryAssessment {
  id String @id @default(uuid())

  rightsComponentId String
  rightsComponent RightsComponent @relation(fields: [rightsComponentId], references: [id], onDelete: Cascade)

  countryCode String
  status TerritoryRightsStatus
  accessPolicy RightsAccessPolicy
  geoBlockRequired Boolean @default(false)
  reasonRu String? @db.Text
  legalBasisRu String? @db.Text
  publicDomainFromYear Int?
  rightsExpireAt DateTime?
  sourceEvidenceIds Json?
  confidence RightsConfidence?
  notesRu String? @db.Text

  licenseLinks RightsLicenseLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rightsComponentId, countryCode])
  @@index([rightsComponentId])
  @@index([countryCode])
  @@index([status])
  @@index([accessPolicy])
  @@index([geoBlockRequired])
  @@index([rightsExpireAt])
}

model RightsEvidence {
  id String @id @default(uuid())

  rightsProfileId String
  rightsProfile RightsProfile @relation(fields: [rightsProfileId], references: [id], onDelete: Cascade)

  evidenceType RightsEvidenceType
  sourceLevel RightsEvidenceSourceLevel

  title String
  authority String
  url String?
  jurisdictionCode String?
  accessedAt DateTime?

  relevantExcerpt String? @db.Text
  summaryRu String @db.Text

  /// WP-9.3 (R3-08): архивная копия доказательства. До этого доказательство было только
  /// `url` — ссылкой, которая завтра отдаст 404, и тогда обоснование блокировки страны
  /// перестаёт существовать. Копию загружает редактор: сервер не ходит по внешним адресам
  /// сам. В content hash файл доказательства не входит (ADR-010): доказательство —
  /// обоснование вердикта, а не содержимое книги.
  storageKey  String?
  fileSha256  String?
  fileName    String?
  contentType String?
  sizeBytes   Int?

  isArchivedCopy   Boolean   @default(false)
  archivedAt       DateTime?
  archivedByUserId String?
  archivedByUser   User? @relation("RightsEvidenceArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)

  /// WP-9.3 (R3-08): доказательство нельзя удалить (ADR-009), но можно пометить устаревшим.
  /// `supersededById` указывает на доказательство, которое пришло ему на смену.
  isCurrent      Boolean @default(true)
  supersededById String? @unique
  supersededBy   RightsEvidence? @relation("RightsEvidenceSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     RightsEvidence? @relation("RightsEvidenceSupersession")

  licenseLinks RightsLicenseLink[]

  // Phase 19: если доказательство создано из юридического заключения
  legalOpinion RightsLegalOpinion?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rightsProfileId])
  @@index([evidenceType])
  @@index([sourceLevel])
  @@index([jurisdictionCode])
  @@index([fileSha256])
  @@index([isCurrent])
  @@index([archivedByUserId])
}

model RightsAction {
  id String @id @default(uuid())

  rightsProfileId String
  rightsProfile RightsProfile @relation(fields: [rightsProfileId], references: [id], onDelete: Cascade)

  actionType RightsActionType
  status RightsActionStatus @default(PENDING)

  descriptionRu String @db.Text
  affectedCountryCodes Json
  isBlocking Boolean @default(false)

  // WP-5.1: жизненный цикл действия. Действие предлагает агент, закрывает человек —
  // без этих полей статус записывался один раз при материализации и не менялся никогда (R3-02).
  assignedToUserId String?
  assignedToUser   User? @relation("RightsActionAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  dueAt DateTime?

  completedAt DateTime?
  completedByUserId String?
  completedByUser   User? @relation("RightsActionCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  completionNotesRu String? @db.Text

  events RightsActionEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rightsProfileId])
  @@index([actionType])
  @@index([status])
  @@index([isBlocking])
  @@index([assignedToUserId])
  @@index([completedByUserId])
  @@index([dueAt])
}

