/// WP-10.1 (R8-02): связь участника с профилем прав удаляется физически — решение WP-0.4
/// от 31.07.2026 оставило физическое удаление связей, потому что мягкое требовало бы
/// фильтрации во всех выборках. Взамен каждая привязка и каждая отвязка пишет сюда
/// неудаляемое событие в той же транзакции, что и сама связь (ADR-009).
///
/// `rightsProfileContributorId`, `personId` и `sourceEditionId` — идентификаторы без внешнего
/// ключа: строка связи к моменту чтения журнала уже удалена, а FK с каскадом снёс бы вместе
/// с ней и запись о том, что связь существовала.
model RightsProfileContributorEvent {
  id String @id @default(uuid())

  rightsProfileId String
  rightsProfile RightsProfile @relation(fields: [rightsProfileId], references: [id], onDelete: Cascade)

  rightsProfileContributorId String
  rightsComponentId String?
  sourceEditionId String?
  personId String?

  eventType RightsProfileContributorEventType

  role ContributorRole?
  displayName String?
  creditedName String?

  payload Json?

  createdByUserId String?
  createdByUser User? @relation("RightsProfileContributorEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([rightsProfileId])
  @@index([rightsProfileContributorId])
  @@index([rightsComponentId])
  @@index([sourceEditionId])
  @@index([personId])
  @@index([eventType])
  @@index([createdAt])
  @@index([createdByUserId])
}

