model RightsClaim {
  id String @id @default(uuid())

  /// Human-readable number in the form CLM-2026-000123, generated by RightsClaimsService.
  claimNumber String @unique

  claimType RightsClaimType
  status    RightsClaimStatus   @default(RECEIVED)
  severity  RightsClaimSeverity @default(MEDIUM)
  channel   RightsClaimChannel  @default(EMAIL)

  receivedAt DateTime  @default(now())
  deadlineAt DateTime?
  resolvedAt DateTime?
  closedAt   DateTime?

  // --- Claimant ---
  claimantName         String
  claimantType         RightsClaimantType @default(UNKNOWN)
  claimantOrganization String?
  claimantEmail        String?
  claimantPhone        String?
  claimantAddress      String? @db.Text
  /// The claimant confirmed they are authorised to act on behalf of the rights holder.
  claimantIsAuthorized Boolean @default(false)
  claimantPersonId String?
  claimantPerson   Person? @relation("RightsClaimClaimant", fields: [claimantPersonId], references: [id], onDelete: SetNull)

  // --- Claim target (polymorphic) ---
  bookId String?
  book   Book? @relation(fields: [bookId], references: [id], onDelete: Cascade)

  bookVersionId String?
  bookVersion   BookVersion? @relation(fields: [bookVersionId], references: [id], onDelete: Cascade)

  rightsProfileId String?
  rightsProfile   RightsProfile? @relation(fields: [rightsProfileId], references: [id], onDelete: SetNull)

  rightsIntakeId String?
  rightsIntake   RightsIntake? @relation(fields: [rightsIntakeId], references: [id], onDelete: SetNull)

  mediaAssetId String?
  mediaAsset   MediaAsset? @relation("RightsClaimMediaAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  // --- Territories and languages ---
  /// Empty array / null = the claim applies in every country.
  affectedCountryCodes Json?
  affectedLanguages    Json?

  // --- Substance of the claim ---
  claimedWorkTitle           String?
  claimedWorkAuthor          String?
  claimedRightsDescriptionRu String? @db.Text
  descriptionRu              String  @db.Text
  infringingUrls             Json?
  goodFaithStatement         Boolean @default(false)
  swornStatement             Boolean @default(false)
  originalNoticeText         String? @db.Text
  originalNoticeUrl          String?

  // --- Handling ---
  assignedToUserId String?
  assignedToUser   User? @relation("RightsClaimAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  internalNotesRu String? @db.Text

  /// The claim blocks publication. Clearing the flag requires an explicit reason.
  blocksPublication                 Boolean @default(true)
  blocksPublicationOverrideReasonRu String? @db.Text

  /// Bridge to Phase 19 (Lawyer Workflow).
  requiresLawyerReview Boolean @default(false)

  // --- Response to the claimant ---
  responseSentAt   DateTime?
  responseChannel  RightsClaimChannel?
  responseTextRu   String? @db.Text
  responseByUserId String?
  responseByUser   User? @relation("RightsClaimRespondedBy", fields: [responseByUserId], references: [id], onDelete: SetNull)

  // --- Counter notice ---
  counterNoticeReceivedAt   DateTime?
  counterNoticeClaimantName String?
  counterNoticeTextRu       String? @db.Text

  // --- Resolution ---
  resolution        RightsClaimResolution?
  resolutionNotesRu String? @db.Text
  resolvedByUserId  String?
  resolvedByUser    User? @relation("RightsClaimResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  // --- Related claims (duplicates, counter notices) ---
  parentClaimId String?
  parentClaim   RightsClaim?  @relation("RightsClaimParent", fields: [parentClaimId], references: [id], onDelete: SetNull)
  childClaims   RightsClaim[] @relation("RightsClaimParent")

  createdByUserId String?
  createdByUser   User? @relation("RightsClaimCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  components   RightsClaimComponent[]
  accessBlocks RightsClaimAccessBlock[]
  attachments  RightsClaimAttachment[]
  events       RightsClaimEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([claimNumber])
  @@index([status])
  @@index([claimType])
  @@index([severity])
  @@index([bookId])
  @@index([bookVersionId])
  @@index([rightsProfileId])
  @@index([rightsIntakeId])
  @@index([assignedToUserId])
  @@index([claimantPersonId])
  @@index([deadlineAt])
  @@index([receivedAt])
  @@index([resolvedAt])
  @@index([blocksPublication])
  @@index([requiresLawyerReview])
  @@index([parentClaimId])
  @@index([createdByUserId])
  @@index([responseByUserId])
  @@index([resolvedByUserId])
  @@index([mediaAssetId])
}

model RightsClaimComponent {
  id String @id @default(uuid())

  rightsClaimId String
  rightsClaim   RightsClaim @relation(fields: [rightsClaimId], references: [id], onDelete: Cascade)

  /// Link to the real rights profile component when one exists.
  rightsComponentId String?
  rightsComponent   RightsComponent? @relation(fields: [rightsComponentId], references: [id], onDelete: SetNull)

  /// Component type for legacy books that have no rights profile.
  componentType RightsComponentType?
  titleRu       String?
  notesRu       String? @db.Text

  createdAt DateTime @default(now())

  @@index([rightsClaimId])
  @@index([rightsComponentId])
  @@index([componentType])
}

model RightsClaimAccessBlock {
  id String @id @default(uuid())

  rightsClaimId String
  rightsClaim   RightsClaim @relation(fields: [rightsClaimId], references: [id], onDelete: Cascade)

  bookId String?
  book   Book? @relation("RightsClaimBlockBook", fields: [bookId], references: [id], onDelete: Cascade)

  bookVersionId String?
  bookVersion   BookVersion? @relation("RightsClaimBlockVersion", fields: [bookVersionId], references: [id], onDelete: Cascade)

  scope GeoBlockScope

  /// null = the block applies worldwide.
  countryCode String?

  status RightsClaimBlockStatus @default(ACTIVE)

  reasonRu String @db.Text

  appliedAt       DateTime  @default(now())
  appliedByUserId String?
  appliedByUser   User? @relation("RightsClaimBlockAppliedBy", fields: [appliedByUserId], references: [id], onDelete: SetNull)

  /// Automatic expiry. Evaluated at runtime, no cron required.
  expiresAt DateTime?

  liftedAt       DateTime?
  liftedByUserId String?
  liftedByUser   User? @relation("RightsClaimBlockLiftedBy", fields: [liftedByUserId], references: [id], onDelete: SetNull)
  liftReasonRu   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rightsClaimId])
  @@index([bookId, status])
  @@index([bookVersionId, status])
  @@index([countryCode])
  @@index([scope])
  @@index([status])
  @@index([expiresAt])
  @@index([appliedByUserId])
  @@index([liftedByUserId])
}

model RightsClaimAttachment {
  id String @id @default(uuid())

  rightsClaimId String
  rightsClaim   RightsClaim @relation(fields: [rightsClaimId], references: [id], onDelete: Cascade)

  attachmentType RightsClaimAttachmentType @default(EVIDENCE)

  title    String
  fileName String?

  mediaAssetId String?
  mediaAsset   MediaAsset? @relation("RightsClaimAttachment", fields: [mediaAssetId], references: [id], onDelete: SetNull)

