model Person {
  id String @id @default(uuid())

  type PersonType @default(NATURAL_PERSON)

  canonicalName String
  sortName String?
  slug String? @unique

  birthDate String?
  deathDate String?
  birthYear Int?
  deathYear Int?

  nationalityCountryCode String?
  publicDomainFromYear Int?

  wikidataId String?
  viafId String?
  isni String?
  gutenbergAgentId String?

  notesRu String? @db.Text

