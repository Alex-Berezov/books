  shortDescription String? @db.Text

  wikidataUrl String?
  wikipediaUrl String?
  photoUrl String?

  seoId Int? @unique
  seo Seo? @relation("SeoForPersonTranslation", fields: [seoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, language])
  @@unique([language, slug])
  @@index([personId])
  @@index([language])
}

