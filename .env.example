# Database
# Default for docker-compose: postgres/postgres@localhost:5432/books
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/books?schema=public"
NODE_ENV=development

# Server
# Port/host for Nest HTTP server (see main.ts). Defaults: PORT=5000, HOST=0.0.0.0
# Leave commented to use code defaults.
# PORT=5000
# HOST=0.0.0.0
# Image tag of the running build. The deploy pipeline sets it and compares it with the tag it
# just built; /health reports "unknown" while it is missing.
# APP_VERSION=

# JWT
JWT_ACCESS_SECRET="Some_secret_1!*@#"
JWT_ACCESS_EXPIRES_IN=12h
JWT_REFRESH_SECRET="Some_secret_2!*@#"
JWT_REFRESH_EXPIRES_IN=7d

# --- Social sign-in (optional) ---
# Credentials of the OAuth apps whose tokens POST /auth/social accepts. Without them the
# provider answers 503 instead of trusting a token it cannot verify.
# AUTH_GOOGLE_ID=
# AUTH_FACEBOOK_ID=
# AUTH_FACEBOOK_SECRET=

# Roles
# Comma-separated email lists for automatic role assignment at register/login
ADMIN_EMAILS=admin@example.com
CONTENT_MANAGER_EMAILS=
ROLES_CACHE_TTL_MS=5000

# Language policy
# Default language fallback when not provided and not matched via Accept-Language
# Must be one of Prisma enum Language: en|es|fr|pt (extend via migration when needed)
DEFAULT_LANGUAGE=en

# Origin of the PUBLIC pages: canonical, hreflang, og:url, JSON-LD, robots.txt, sitemap.
# Unset means the hardcoded default https://bibliaris.com (DEFAULT_PUBLIC_SITE_URL).
# It must never be a service host (api./media./cdn./static./assets.) and must not equal
# LOCAL_PUBLIC_BASE_URL or R2_PUBLIC_BASE_URL — those say where *files* are served from, not
# where *pages* live. The app refuses to start on a value that breaks either rule.
# PUBLIC_SITE_URL=https://bibliaris.com

# Public base URL for link generation.
# SEO/Sitemap fallback if undefined: http://localhost:3000,
# local storage (LocalStorageService) fallback: http://localhost:5000.
# Setting this overrides SEO/Sitemap base AND public file links.
LOCAL_PUBLIC_BASE_URL=http://localhost:5000

# --- Compose overrides (optional) ---
# Override ports/settings of services defined in docker-compose.yml
POSTGRES_DB=books
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Sentry (optional) ---
# To enable error reporting set DSN (from your Sentry project).
# Integration auto-enables if SENTRY_DSN is set. Force disable: SENTRY_ENABLED=0
# SENTRY_DSN=
# SENTRY_ENABLED=1
# SENTRY_ENV=development
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_PROFILES_SAMPLE_RATE=0

# --- BullMQ / Queues (optional) ---
# Redis URL overrides host/port. If neither REDIS_URL nor REDIS_HOST are set queues are disabled.
# Example URL: redis://localhost:6379
# REDIS_URL=
# REDIS_HOST=localhost
# REDIS_PASSWORD=
# BULLMQ_DEMO_QUEUE=demo
# BULLMQ_DEMO_CONCURRENCY=2
# BULLMQ_IN_PROCESS_WORKER=1
# BULLMQ_WORKER_LOG_LEVEL=info
# BULLMQ_WORKER_SHUTDOWN_TIMEOUT_MS=5000

# --- Media jobs: probe and cleanup (optional) ---
# Both queues need Redis. Without it the jobs are registered as disabled and nothing runs.
# BULLMQ_MEDIA_PROBE_QUEUE=media-probe
# BULLMQ_MEDIA_PROBE_CONCURRENCY=2
# MEDIA_PROBE_ATTEMPTS=3
# BULLMQ_MEDIA_CLEANUP_QUEUE=media-cleanup
# 0 or false turns the cleanup off; anything else leaves it on
# MEDIA_CLEANUP_ENABLED=1
# MEDIA_CLEANUP_CRON=15 3 * * *
# Age at which an orphaned upload is soft-deleted, and at which it is removed for good
# MEDIA_CLEANUP_SOFT_DAYS=7
# MEDIA_CLEANUP_HARD_DAYS=30

# --- Uploads / limits (optional, defaults exist in code) ---
# LOCAL_UPLOADS_DIR=var/uploads
# UPLOADS_MAX_IMAGE_MB=5
# UPLOADS_MAX_AUDIO_MB=100
# UPLOADS_PRESIGN_TTL_SEC=600
# UPLOADS_ALLOWED_IMAGE_CT=image/jpeg,image/png,image/webp
# UPLOADS_ALLOWED_AUDIO_CT=audio/mpeg,audio/mp4,audio/aac,audio/ogg

# --- Storage driver: local | r2 ---
# STORAGE_DRIVER=local
# LOCAL_PUBLIC_BASE_URL=http://localhost:5000

# Cloudflare R2 (required when STORAGE_DRIVER=r2)
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=books-media
# R2_PUBLIC_BASE_URL=https://media.bibliaris.com
# R2_KEY_PREFIX=
# R2_CACHE_CONTROL=public, max-age=31536000, immutable

# --- Cache / rate limits (optional) ---
# VIEWS_CACHE_TTL_MS=30000
# SITEMAP_CACHE_TTL_MS=60000
# SEO_CACHE_TTL_MS=0
# RATE_LIMIT_ENABLED=0
# RATE_LIMIT_COMMENTS_PER_MINUTE=10
# RATE_LIMIT_COMMENTS_WINDOW_MS=60000
# Global throttling (all requests except health/metrics/swagger)
# RATE_LIMIT_GLOBAL_ENABLED=0
# RATE_LIMIT_GLOBAL_MAX=100
# RATE_LIMIT_GLOBAL_WINDOW_MS=60000
# Per-route limits for /auth.
# RATE_LIMIT_AUTH_ENABLED is compared literally with "1": unset means on, and any other value —
# including true, on and yes — turns the whole /auth limiter OFF. Leave it unset or write 1.
# RATE_LIMIT_AUTH_ENABLED=1
# For the numbers below, a value that is not a positive number is ignored and the code default
# shown here applies.
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_LOGIN_WINDOW_MS=60000
# RATE_LIMIT_REGISTER_MAX=3
# RATE_LIMIT_REGISTER_WINDOW_MS=300000
# RATE_LIMIT_REFRESH_MAX=10
# RATE_LIMIT_REFRESH_WINDOW_MS=60000
# Catch-all for every other route under /auth (today /social and /logout)
# RATE_LIMIT_AUTH_DEFAULT_MAX=10
# RATE_LIMIT_AUTH_DEFAULT_WINDOW_MS=60000
# Uploads by an outside rights agent: 20 per hour by default.
# RATE_LIMIT_AGENT_UPLOAD_ENABLED follows the same literal "1" rule as RATE_LIMIT_AUTH_ENABLED.
# RATE_LIMIT_AGENT_UPLOAD_ENABLED=1
# RATE_LIMIT_AGENT_UPLOAD_MAX=20
# RATE_LIMIT_AGENT_UPLOAD_WINDOW_MS=3600000

# --- CORS (optional) ---
# Allowed origins. Supports:
#  - wildcard (dev): *
#  - single origin: https://app.example.com
#  - comma list: https://app.example.com,https://admin.example.com
# In production use an explicit whitelist instead of "*".
CORS_ORIGIN=*
# Enable credentialed requests (cookies/Authorization with withCredentials)
# Only with specific origins; do not combine with "*".
# 0 — off (default), 1 — on
CORS_CREDENTIALS=0

# --- Body limits (optional) ---
# BODY_LIMIT_JSON=1mb
# BODY_LIMIT_URLENCODED=1mb

# --- Reverse Proxy (prod) ---
# If app runs behind reverse proxy/ingress enable trust of X-Forwarded-* headers
# 0 — off, 1 — on
TRUST_PROXY=0
# Which proxies may set the client-ip headers the rate limiters count by.
# TRUSTED_PROXY_CIDRS — comma- or space-separated. Empty means the built-in Cloudflare list
# (DEFAULT_TRUSTED_PROXY_CIDRS in src/common/net/client-ip.ts). A non-empty value REPLACES that
# list, it does not extend it: write out every trusted range, or CF-Connecting-IP stops being
# believed and one edge node's address becomes the rate-limit bucket for everyone behind it.
# INTERNAL_PROXY_CIDRS — addresses of our own frontend as the API sees them. Empty by default
# and deliberately so: a wrong entry here hands the X-Visitor-IP bypass to a stranger.
# TRUSTED_PROXY_CIDRS=
# INTERNAL_PROXY_CIDRS=

# --- Metrics (optional) ---
# Long-lived bearer token for GET /api/metrics, so Prometheus can scrape without an admin JWT.
# An empty or unset value does not open the route — the comparison only runs for a non-empty
# secret, and the admin JWT stays the other way in.
# METRICS_TOKEN=

# --- GeoIP market blocking (Phase 12) ---
# What to do when the country of the request could not be resolved (no trusted header at all).
# allow (default) — serve the content, unless the version already has an active geo-block rule
#   that could cover this request. Risk: if the country source disappears (Cloudflare outage,
#   a request that bypasses the proxy), the geo contour silently switches off for every version
#   whose rules are not generated yet.
# deny — answer 451 for every geo-checked request without a country, rules table not consulted.
#   Risk: an outage of the country source closes the reader, the player and the version pages at
#   once, and so does any geo-checked request that arrives without Cloudflare in front of it.
# The value is trimmed and lowercased, so "DENY " still denies; anything that is not the word deny
# (a typo, "0", "false", "block") means allow — a value meant as a refusal opens access instead.
# Owner decision 15.08.2026: allow. There are 0 active geo-block rules in production, so deny
# would protect nothing today and would produce refusals immediately (LEGACY-171).
# On the running server this file is not read: the container gets .env.prod, and every deploy
# recreates it from the ENV_PROD GitHub secret — so changing the value here alone changes nothing
# there. It does seed a brand new machine (setup_server.sh copies this file to .env.prod), which is
# why the value has to be right in both places.
RIGHTS_GEO_UNKNOWN_COUNTRY_POLICY=allow
# X-Geo-Country (ENABLE_GEO_TEST_HEADERS) is deliberately not listed here: the flag is honoured in
# any environment, and turning it on lets every client name its own country. The e2e suites set it
# in their own process; nothing else should (LEGACY-172, LEGACY-208).
# X-Country-Code is the same kind of switch and nothing in this deployment overwrites that header —
# neither Cloudflare nor Caddy touches it — so leave the flag off until a proxy that does exists.
# ENABLE_X_COUNTRY_CODE_HEADER=true

# --- Rights: private file storage (optional) ---
# Where the rights-intake attachments live and what may be uploaded. The size limit is enforced
# by RightsFileStorageService; multer allows 2 MB more so an oversized body still gets a
# readable 413 instead of a connection reset.
# RIGHTS_FILES_MAX_MB=25
# RIGHTS_FILES_LOCAL_DIR=./var/rights-files
# Key prefix used when STORAGE_DRIVER=r2 (goes after R2_KEY_PREFIX)
# RIGHTS_FILES_KEY_PREFIX=rights-private
# RIGHTS_FILES_ALLOWED_REPORT_CT=application/pdf
# RIGHTS_FILES_ALLOWED_SOURCE_CT=application/pdf,application/epub+zip,text/plain,text/html,application/xhtml+xml
# RIGHTS_FILES_ALLOWED_EVIDENCE_CT=application/pdf,image/png,image/jpeg,image/webp,text/html,text/plain

# --- Rights: agent uploads (optional) ---
# One-time tokens handed to an outside rights agent, and the size of the report they may send.
# RIGHTS_AGENT_UPLOAD_ENABLED is compared literally with "1": unset means on, anything else off.
# RIGHTS_AGENT_UPLOAD_ENABLED=1
# RIGHTS_AGENT_TOKEN_TTL_HOURS=72
# RIGHTS_AGENT_MAX_REPORT_BYTES=2000000

# --- Rights: lawyer workflow (optional) ---
# 0, false and off disable a flag; anything unrecognised leaves the default in place.
# RIGHTS_LAWYER_WORKFLOW_ENABLED=1
# Refuse approval of a profile whose risk reaches the threshold and has no valid opinion
# RIGHTS_LAWYER_BLOCK_APPROVAL_ON_HIGH_RISK=1
# One of LOW|MEDIUM|HIGH|CRITICAL; an unrecognised value means HIGH
# RIGHTS_LAWYER_MIN_RISK_LEVEL=HIGH
# RIGHTS_LAWYER_REVIEW_DUE_DAYS=14
# RIGHTS_LAWYER_OPINION_VALIDITY_DAYS=730
# RIGHTS_LAWYER_OPINION_EXPIRY_WARN_DAYS=60

# --- Rights: periodic recheck (optional) ---
# Background scan that marks rights profiles due for a recheck.
# RIGHTS_RECHECK_SCHEDULER_ENABLED is compared literally with "0": only that exact value stops
# the scan, anything else (including false and off) leaves it running.
# RIGHTS_RECHECK_SCHEDULER_ENABLED=1
# RIGHTS_RECHECK_SCAN_INTERVAL_MS=21600000
# RIGHTS_RECHECK_SCAN_INITIAL_DELAY_MS=60000
# RIGHTS_RECHECK_SCAN_BATCH_SIZE=500
# How long a profile stays valid, and how many days ahead reminders go out (comma separated)
# RIGHTS_RECHECK_DEFAULT_INTERVAL_DAYS=365
# RIGHTS_RECHECK_REMINDER_LEAD_DAYS=30,7
# RIGHTS_RECHECK_OVERDUE_GRACE_DAYS=30
# Due dates for the two event-driven recheck reasons
# RIGHTS_RECHECK_LEGAL_CHANGE_DUE_DAYS=14
# RIGHTS_RECHECK_EVENT_DUE_DAYS=7
# 0 lets a version whose rights recheck is overdue be published anyway
# RIGHTS_RECHECK_BLOCK_PUBLISH_ON_OVERDUE=1

# --- Taxonomy indexability sweep (optional) ---
# Daily safety-net recount of bookCount and autoIndexable for taxonomy pages.
# TAXONOMY_INDEXABILITY_SCHEDULER_ENABLED is compared literally with "0": only that exact value
# stops the sweep, anything else leaves it running.
# TAXONOMY_INDEXABILITY_SCHEDULER_ENABLED=1
# TAXONOMY_INDEXABILITY_SWEEP_HOUR_UTC=3

# --- Monitoring Stack (optional) ---
# Ports for monitoring services
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# NODE_EXPORTER_PORT=9100
# ALERTMANAGER_PORT=9093

# Grafana settings
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin123
# GRAFANA_DOMAIN=localhost
# GRAFANA_ROOT_URL=http://localhost:3000

# AlertManager notification settings
# ALERT_EMAIL_FROM=alerts@example.com
# ALERT_EMAIL_TO=admin@example.com
# SMTP_HOST=localhost:587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Slack notifications (optional)
# SLACK_WEBHOOK_URL=
# SLACK_CHANNEL=#alerts
